@bot.on(events.CallbackQuery(data=b"buy_subscription"))
async def buy_sub_cb(event):
    await event.respond(
        f"💰 ПОКУПКА ПОДПИСКИ\n\n💵 {PRICE_PER_DAY} руб/день",
        buttons=[
            [Button.inline("7 дней", b"sub_7"), Button.inline("30 дней", b"sub_30")],
            [Button.inline("90 дней", b"sub_90"), Button.inline("🔥 Навсегда", b"sub_forever")],
            [Button.inline("❌ Назад", b"back_to_main")]
        ]
    )

@bot.on(events.CallbackQuery(func=lambda e: e.data.startswith(b"sub_")))
async def process_sub_cb(event):
    uid = event.sender_id
    action = event.data.decode()
    days_map = {"sub_7": 7, "sub_30": 30, "sub_90": 90, "sub_forever": 9999}
    days = days_map.get(action, 0)
    amount = 99999 if days == 9999 else days * PRICE_PER_DAY
    pid = save_payment(uid, days, amount)
    await event.respond(f"💳 Переведите {amount} руб на карту `{CARD_NUMBER}`\n\n✅ После перевода нажмите кнопку подтверждения.", buttons=[[Button.inline("✅ Я перевел", f"pay_{pid}")]])

@bot.on(events.CallbackQuery(func=lambda e: e.data.startswith(b"pay_")))
async def pay_cb(event):
    pid = int(event.data.decode().split("_")[1])
    for admin in ADMIN_IDS:
        try: await bot.send_message(admin, f"💰 Платеж {pid} от {event.sender_id}\n/confirm {pid}")
        except: pass
    await event.respond("✅ Заявка отправлена! Ожидайте.", buttons=get_main_menu(event.sender_id))

