    # Аккаунты
    if data == "add_account":
        await bot.send_message(uid,
            "📱 Введите номер телефона:\n+7XXXXXXXXXX",
            buttons=[[Button.inline("◀️ Назад", b"back_to_main")]]
        )
        user_states[uid] = {"state": "add_account_phone"}
        await event.answer()
        return
    
    # Инфо
    if data == "info":
        days = get_remaining_days(uid)
        sub_type = get_subscription_type(uid)
        stats = get_user_stats(uid)
        
        text = f"ℹ️ ИНФОРМАЦИЯ\n\n"
        text += f"🤖 Бот: @{BOT_USERNAME}\n"
        text += f"📌 Версия: {VERSION}\n"
        text += f"📦 Подписка: {sub_type}\n"
        text += f"📅 Осталось: {days} дн.\n\n"
        text += f"📊 Статистика:\n"
        text += f"├ 📨 Отправок: {stats['total_sends']}\n"
        text += f"├ 👥 Групп: {stats['total_groups']}\n"
        text += f"├ 💳 Платежей: {stats['total_payments']}\n"
        text += f"└ 💰 Потрачено: {stats['total_spent']} руб\n\n"
        text += f"📱 Поддержка: @sikvvg"
        
        await event.edit(text, buttons=[[Button.inline("◀️ Назад", b"back_to_main")]])
        return
    
    # Админ панель
    if data == "admin_panel":
        if uid not in ADMIN_IDS:
            await event.answer("❌ Доступ запрещен", alert=True)
            return
        
        stats = get_stats()
        text = f"👑 АДМИН ПАНЕЛЬ\n\n"
        text += f"👥 Всего: {stats['total_users']}\n"
        text += f"🟢 Активных: {stats['active_users']}\n"
        text += f"💰 Выручка: {stats['revenue']} руб\n"
        text += f"👥 Групп: {stats['groups']}\n"
        text += f"💳 Ожидают: {stats['pending']}\n"
        text += f"⛔ Заблокировано: {stats['banned']}"
        
        await event.edit(text, buttons=get_admin_menu())
        return
    
    if data == "admin_stats":
        if uid not in ADMIN_IDS:
            await event.answer("❌ Доступ запрещен", alert=True)
            return
        stats = get_stats()
        text = f"📊 СТАТИСТИКА\n\n"
        text += f"👥 Всего: {stats['total_users']}\n"
        text += f"🟢 Активных: {stats['active_users']}\n"
        text += f"💰 Выручка: {stats['revenue']} руб\n"
        text += f"👥 Групп: {stats['groups']}\n"
        text += f"💳 Ожидают: {stats['pending']}\n"
        text += f"⛔ Заблокировано: {stats['banned']}"
        await event.edit(text, buttons=get_admin_menu())
        return
    
    if data == "admin_users":
        if uid not in ADMIN_IDS:
            await event.answer("❌ Доступ запрещен", alert=True)
            return
        users = get_all_users()
        text = f"👥 ПОЛЬЗОВАТЕЛИ ({len(users)})\n\n"
        for u in users[:20]:
            status = "🟢" if u.has_subscription else "🔴"
            if u.is_banned:
                status = "⛔"
            text += f"{status} `{u.user_id}` | @{u.username} | {u.subscription_type}\n"
        if len(users) > 20:
            text += f"\n... и еще {len(users) - 20}"
        await event.edit(text, buttons=get_admin_menu())
        return
    
    if data == "admin_payments":
        if uid not in ADMIN_IDS:
            await event.answer("❌ Доступ запрещен", alert=True)
            return
        await event.edit("💳 Ожидающие платежи", buttons=get_admin_menu())
        return
    
    if data == "admin_broadcast":
        if uid not in ADMIN_IDS:
            await event.answer("❌ Доступ запрещен", alert=True)
            return
        await bot.send_message(uid, 
            "📢 АДМИН РАССЫЛКА\n\nОтправьте сообщение для всех пользователей.",
            buttons=[[Button.inline("◀️ Назад", b"admin_panel")]]
        )
        user_states[uid] = {"state": "admin_broadcast"}
        await event.answer()
        return
    
    # Назад
    if data == "back_to_main":
        user_states.pop(uid, None)
        pending_broadcast.pop(uid, None)
        selected_groups.pop(uid, None)
        temp_data.pop(uid, None)
        days = get_remaining_days(uid)
        sub_type = get_subscription_type(uid)
        await event.edit(
            f"👋 Главное меню\n📦 Подписка: {sub_type}\n📅 Осталось: {days} дн.",
            buttons=get_main_menu(uid)
        )
        await event.answer()
        return

# ============================================================================
# ОБРАБОТЧИКИ СООБЩЕНИЙ
# ============================================================================
@bot.on(events.NewMessage)
async def handle_messages(event):
    uid = event.sender_id
    if not event.text and not event.media:
        return
    
    text = event.text or ""
    state = user_states.get(uid, {}).get("state")
    
    # Поиск групп
    if state == "search_groups":
        filter_text = text.strip()
        await show_group_selection(uid, 0, filter_text)
        user_states.pop(uid, None)
        return
    
    # Сообщение для рассылки
    if state == "broadcast_message":
        broadcast_data = pending_broadcast.get(uid)
        if not broadcast_data:
            await event.respond("❌ Данные потеряны")
            user_states.pop(uid, None)
            return
        
        message_text = text
        image_data = None
        
        if event.media and event.photo:
            try:
                image_data = await event.download_media(bytes)
            except Exception as e:
                logger.error(f"❌ Ошибка загрузки фото: {e}")
                await event.respond("⚠️ Не удалось загрузить изображение")
                return
        
        if not message_text and not image_data:
            await event.respond("📝 Отправьте текст или текст с изображением")
            return
        
        broadcast_data['message'] = message_text
        broadcast_data['image_data'] = image_data
        
        groups_count = len(broadcast_data['groups'])
        has_image = "📷 с изображением" if image_data else "📝 текстовое"
        preview = message_text[:200] + "..." if len(message_text) > 200 else message_text
        
        await event.respond(
            f"📨 ПОДТВЕРДИТЕ РАССЫЛКУ\n\nГрупп: {groups_count}\nТип: {has_image}\n\n{preview}\n\n✅ Начинаем?",
            buttons=[
                [Button.inline("✅ Начать", b"confirm_broadcast")],
                [Button.inline("❌ Отмена", b"cancel_broadcast")]
            ]
        )
        user_states[uid] = {"state": "broadcast_confirm"}
        return
    
    # Добавление аккаунта
    if state == "add_account_phone":
        phone = text.strip()
        if not validate_phone(phone):
            await event.respond("❌ Неверный формат. Используйте +7XXXXXXXXXX")
            return
        
        user_phones[uid] = phone
        
        try:
            client = TelegramClient(StringSession(), API_ID, API_HASH)
            await client.connect()
            await client.send_code_request(phone)
            user_clients[uid] = client
            user_states[uid] = {"state": "add_account_code"}
            await event.respond(f"📱 Код отправлен на {phone}\n\nВведите код из Telegram:")
        except Exception as e:
            await event.respond(f"❌ Ошибка: {str(e)[:100]}")
            user_states.pop(uid, None)
        return
    
    if state == "add_account_code":
        client = user_clients.get(uid)
        if not client:
            await event.respond("❌ Сессия истекла")
            user_states.pop(uid, None)
            return
        
        phone = user_phones.get(uid, "")
        code = text.strip()
        
        try:
            await client.sign_in(phone, code)
            session_string = client.session.save()
            save_session(uid, session_string)
            
            await event.respond(f"✅ Аккаунт {phone} успешно добавлен!")
            logger.info(f"✅ Аккаунт добавлен: {phone}")
            
            await client.disconnect()
            user_clients.pop(uid, None)
            user_states.pop(uid, None)
            user_phones.pop(uid, None)
            
            await event.respond("👋 Главное меню", buttons=get_main_menu(uid))
            
        except SessionPasswordNeededError:
            user_states[uid] = {"state": "add_account_password"}
            await event.respond("🔐 Введите пароль 2FA:")
        except PhoneCodeInvalidError:
            await event.respond("❌ Неверный код. Попробуйте еще раз:")
        except Exception as e:
            await event.respond(f"❌ Ошибка: {str(e)[:100]}")
            user_states.pop(uid, None)
        return
    
    if state == "add_account_password":
        client = user_clients.get(uid)
        if not client:
            await event.respond("❌ Сессия истекла")
            user_states.pop(uid, None)
            return
        
        password = text.strip()
        phone = user_phones.get(uid, "")
        
        try:
            await client.sign_in(password=password)
            session_string = client.session.save()
            save_session(uid, session_string)
            
            await event.respond(f"✅ Аккаунт {phone} успешно добавлен!")
            logger.info(f"✅ Аккаунт добавлен: {phone}")
            
            await client.disconnect()
            user_clients.pop(uid, None)
            user_states.pop(uid, None)
            user_phones.pop(uid, None)
            
            await event.respond("👋 Главное меню", buttons=get_main_menu(uid))
            
        except Exception as e:
            await event.respond(f"❌ Ошибка: {str(e)[:100]}")
            user_states.pop(uid, None)
        return
    
    # Подтверждение платежа
    if state == "payment_confirm":
        if event.media and event.photo:
            await event.respond("✅ Скриншот получен! Ожидайте подтверждения.")
            
            for admin_id in ADMIN_IDS:
                try:
                    await bot.send_message(admin_id, f"💳 НОВЫЙ ПЛАТЕЖ\n👤 Пользователь: {uid}")
                    await bot.forward_messages(admin_id, event.message)
                except:
                    pass
            
            user_states.pop(uid, None)
        else:
            await event.respond("📷 Отправьте скриншот платежа")
        return
    
    # Админ рассылка
    if state == "admin_broadcast":
        if uid not in ADMIN_IDS:
            await event.respond("❌ Доступ запрещен")
            user_states.pop(uid, None)
            return
        
        message_text = text
        image_data = None
        
        if event.media and event.photo:
            try:
                image_data = await event.download_media(bytes)
            except:
                pass
        
        if not message_text:
            await event.respond("📝 Отправьте текст")
            return
        
        users = get_all_users()
        await event.respond(f"⏳ Отправка админ рассылки {len(users)} пользователям...")
        
        sent = 0
        for user in users:
            try:
                if image_data:
                    await bot.send_file(user.user_id, image_data, caption=message_text)
                else:
                    await bot.send_message(user.user_id, message_text)
                sent += 1
                await asyncio.sleep(0.5)
            except:
                pass
        
        await event.respond(f"✅ Админ рассылка завершена!\n📨 Отправлено: {sent}")
        user_states.pop(uid, None)
        return
    
    # Команды
    if text.startswith("/start"):
        user = await event.get_sender()
        is_new = register_user(uid, user.username, user.first_name, user.last_name or "")
        
        days = get_remaining_days(uid)
        sub_type = get_subscription_type(uid)
        
        welcome = f"👋 Добро пожаловать в бот @{BOT_USERNAME}!\n\n"
        welcome += f"🤖 Бот для массовых рассылок в Telegram.\n"
        welcome += f"📦 Подписка: {sub_type}\n"
        welcome += f"📅 Осталось: {days} дн.\n\n"
        welcome += f"🚀 Для начала:\n1️⃣ Добавьте аккаунт\n2️⃣ Импортируйте группы\n3️⃣ Начните рассылку"
        
        await event.respond(welcome, buttons=get_main_menu(uid))
        return
    
    if text.startswith("/help"):
        help_text = f"🤖 ПОМОЩЬ @{BOT_USERNAME}\n\n"
        help_text += "/start - Главное меню\n"
        help_text += "/help - Справка\n\n"
        help_text += "📱 Поддержка: @sikvvg"
        await event.respond(help_text)
        return
    
    # Если не в состоянии - показываем меню
    if uid not in user_states:
        days = get_remaining_days(uid)
        sub_type = get_subscription_type(uid)
        await event.respond(
            f"👋 Главное меню\n📦 Подписка: {sub_type}\n📅 Осталось: {days} дн.",
            buttons=get_main_menu(uid)
        )

# ============================================================================
# ЗАПУСК БОТА
# ============================================================================
async def main():
    logger.remove()
    logger.add(sys.stdout, level="INFO")
    logger.add(LOG_FILE, rotation="1 day", retention="7 days", level="DEBUG")
    
    init_database()
    
    await bot.start(bot_token=BOT_TOKEN)
    logger.info(f"🚀 Бот @{BOT_USERNAME} запущен! Версия {VERSION}")
    
    scheduler.start()
    
    for admin_id in ADMIN_IDS:
        try:
            await bot.send_message(admin_id, 
                f"🚀 Бот @{BOT_USERNAME} запущен!\n📌 Версия: {VERSION}")
        except:
            pass
    
    await bot.run_until_disconnected()

if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        logger.info("🛑 Бот остановлен")
    except Exception as e:
        logger.error(f"❌ Ошибка: {e}")
        traceback.print_exc()
