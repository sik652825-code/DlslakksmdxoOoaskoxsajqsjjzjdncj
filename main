def install_pkg(pkg):
    try:
        __import__(pkg)
        return True
    except ImportError:
        import subprocess
        print(f"📦 Установка {pkg}...")
        subprocess.check_call([sys.executable, "-m", "pip", "install", pkg])
        return True

for pkg in ['telethon', 'loguru', 'pillow']:
    install_pkg(pkg)

