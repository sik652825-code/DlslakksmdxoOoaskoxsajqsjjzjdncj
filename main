    await event.respond(text, buttons=get_main_menu(event.sender_id))

@bot.on(events.CallbackQuery(data=b"show_history"))
async def history_cb(event):
    with get_db_connection() as conn:
        c = conn.cursor()
        c.execute("SELECT group_name, sent_at, message_text, status FROM send_history WHERE user_id = ? ORDER BY sent_at DESC LIMIT 10", (event.sender_id,))
        rows = c.fetchall()
    if not rows:
        await event.respond("📭 История пуста", buttons=get_main_menu(event.sender_id)); return
    await event.respond("📜 Последние 10 действий:\n\n" + "\n".join([f"{'✅' if r[3]=='sent' else '❌'} {r[0]} | {truncate_text(r[2], 30)}" for r in rows]), buttons=get_main_menu(event.sender_id))

