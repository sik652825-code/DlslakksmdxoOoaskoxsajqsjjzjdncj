@bot.on(events.NewMessage(pattern="/start"))
async def start(event):
    uid = event.sender_id
    user = await event.get_sender()
    reg_user(uid, user.username, user.first_name)
    st, days = get_sub(uid)
    await event.respond(
        f"👋 @{BOT_NAME}\n📦 {st} | {days} дн.\n\n🚀 Добавь аккаунт → импортируй группы → делай рассылку!",
        buttons=menu(uid)
    )

@bot.on(events.NewMessage(pattern="/help"))
