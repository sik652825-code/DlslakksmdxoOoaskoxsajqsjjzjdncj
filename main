    user_states[uid] = {"action": "send_wait_msg", "groups": groups}
    await event.respond(f"📨 Введите текст сообщения:", buttons=[[Button.inline("❌ Отмена", b"cancel_send")]])

@bot.on(events.NewMessage(func=lambda e: e.sender_id in user_states and user_states[e.sender_id].get("action") == "send_wait_msg"))
async def process_one_time_send(event):
    uid = event.sender_id
    text = event.text.strip()
    groups = user_states[uid].get("groups", [])
    if uid in user_states: del user_states[uid]
    await event.respond(f"🔄 Отправка в {len(groups)} групп...")
    result = await send_message_to_groups(uid, groups, text, delay_seconds=2)
    await event.respond(f"✅ Рассылка завершена!\nУспешно: {result['success']}\nОшибок: {result['fails']}", buttons=get_main_menu(uid))

