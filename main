@bot.on(events.CallbackQuery(data=b"add_all_groups"))
async def add_all_groups_cb(event):
    uid = event.sender_id
    if not check_subscription(uid):
        await event.respond("❌ Подписка истекла!", buttons=get_main_menu(uid)); return
    session = get_session(uid)
    if not session:
        await event.respond("❌ Сначала добавьте аккаунт!", buttons=get_main_menu(uid)); return
    await event.respond("🔄 Загрузка групп...")
    try:
        client = TelegramClient(StringSession(session), API_ID, API_HASH)
        await client.connect()
        with get_db_connection() as conn:
            conn.cursor().execute("DELETE FROM groups WHERE user_id = ?", (uid,)); conn.commit()
        found = 0
        for d in await client.get_dialogs():
            if d.is_group:
                add_group(uid, d.entity.id, d.name, d.name, "group")
                found += 1
        await client.disconnect()
        await event.respond(f"✅ Добавлено групп: {found}", buttons=get_main_menu(uid))
    except Exception as e:
        await event.respond(f"❌ Ошибка: {str(e)[:200]}", buttons=get_main_menu(uid))

@bot.on(events.NewMessage(func=lambda e: e.sender_id in user_states and user_states[e.sender_id].get("action") in ["add_groups_by_link", "add_groups_by_list"]))
async def process_add_groups(event):
    uid = event.sender_id
    result = await add_groups_by_link(uid, event.text.strip())
    if result['success'] > 0:
        await event.respond(f"✅ Добавлено групп: {result['success']}", buttons=get_main_menu(uid))
    else:
        await event.respond(f"❌ Ошибка: {result.get('failed', 'Неизвестная ошибка')}", buttons=get_main_menu(uid))
    if uid in user_states: del user_states[uid]

