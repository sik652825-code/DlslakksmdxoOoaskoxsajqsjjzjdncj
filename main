# ============================================================================
# БАЗА ДАННЫХ
# ============================================================================
def db_init():
    conn = sqlite3.connect(DB)
    conn.execute('''
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY,
            username TEXT,
            name TEXT,
            reg TEXT,
            sub_end TEXT,
            sub_type TEXT DEFAULT 'Нет',
            has_sub INTEGER DEFAULT 0,
            paid INTEGER DEFAULT 0,
            trial INTEGER DEFAULT 0,
            banned INTEGER DEFAULT 0,
            ref TEXT
        )
    ''')
    conn.execute('''
        CREATE TABLE IF NOT EXISTS sessions (
            id INTEGER PRIMARY KEY,
            session TEXT,
            created TEXT
        )
    ''')
    conn.execute('''
        CREATE TABLE IF NOT EXISTS groups (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            group_id INTEGER,
            title TEXT,
            username TEXT,
            added TEXT,
            sent INTEGER DEFAULT 0
        )
    ''')
    conn.execute('''
        CREATE TABLE IF NOT EXISTS history (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            group_title TEXT,
            sent_at TEXT,
            text TEXT,
            status TEXT
        )
    ''')
    conn.execute('''
        CREATE TABLE IF NOT EXISTS payments (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            days INTEGER,
            amount INTEGER,
            status TEXT DEFAULT 'pending',
            created TEXT
        )
    ''')
    conn.commit()
    conn.close()
    logger.info("✅ База данных готова")

def db_query(query, params=(), fetchone=False, fetchall=False):
    conn = sqlite3.connect(DB)
    conn.row_factory = sqlite3.Row
    cur = conn.execute(query, params)
    if fetchone:
        result = cur.fetchone()
    elif fetchall:
        result = cur.fetchall()
    else:
        result = None
    conn.commit()
    conn.close()
    return result

# ============================================================================
# ФУНКЦИИ
# ============================================================================
def get_user(user_id):
    row = db_query('SELECT * FROM users WHERE id = ?', (user_id,), fetchone=True)
    return dict(row) if row else None

def reg_user(user_id, username, name):
    if get_user(user_id):
        return False
    ref = ''.join(random.choices(string.ascii_uppercase + string.digits, k=8))
    db_query(
        'INSERT INTO users (id, username, name, reg, ref) VALUES (?, ?, ?, ?, ?)',
        (user_id, username or '', name or '', datetime.now().isoformat(), ref)
    )
    return True

def has_sub(user_id):
    row = db_query('SELECT sub_end, has_sub, banned FROM users WHERE id = ?', (user_id,), fetchone=True)
    if not row or row[2]:
        return False
    if row[1] and row[0]:
        try:
            return datetime.now() < datetime.fromisoformat(row[0])
        except:
            pass
    return False

def get_sub(user_id):
    row = db_query('SELECT sub_type, sub_end FROM users WHERE id = ?', (user_id,), fetchone=True)
    if not row:
        return "Нет", 0
    days = 0
    if row[1]:
        try:
            days = max(0, (datetime.fromisoformat(row[1]) - datetime.now()).days)
        except:
            pass
    return row[0] or "Нет", days

def trial(user_id):
    row = db_query('SELECT trial, sub_end FROM users WHERE id = ?', (user_id,), fetchone=True)
    if not row or row[0]:
        return False
    if row[1]:
        try:
            if datetime.now() < datetime.fromisoformat(row[1]):
                return False
        except:
            pass
    end = (datetime.now() + timedelta(days=TRIAL_DAYS)).isoformat()
    db_query(
        'UPDATE users SET sub_end = ?, sub_type = ?, has_sub = 1, trial = 1 WHERE id = ?',
        (end, "Пробная", user_id)
    )
    return True

def extend_sub(user_id, days, amount):
    row = db_query('SELECT sub_end FROM users WHERE id = ?', (user_id,), fetchone=True)
    if row and row[0]:
        try:
            current = datetime.fromisoformat(row[0])
            end = current + timedelta(days=days) if datetime.now() < current else datetime.now() + timedelta(days=days)
        except:
            end = datetime.now() + timedelta(days=days)
    else:
        end = datetime.now() + timedelta(days=days)
    
    if days >= 9999:
        st = "НАВСЕГДА"
    elif days >= 365:
        st = "VIP"
    elif days >= 90:
        st = "PREMIUM"
    else:
        st = "Базовая"
    
    db_query(
        'UPDATE users SET sub_end = ?, sub_type = ?, has_sub = 1, paid = paid + ? WHERE id = ?',
        (end.isoformat(), st, amount, user_id)
    )

def save_session(user_id, session):
    db_query('INSERT OR REPLACE INTO sessions (id, session, created) VALUES (?, ?, ?)',
             (user_id, session, datetime.now().isoformat()))

def get_session(user_id):
    row = db_query('SELECT session FROM sessions WHERE id = ?', (user_id,), fetchone=True)
    return row[0] if row else None

def add_group(user_id, group_id, title, username=''):
    db_query('INSERT OR IGNORE INTO groups (user_id, group_id, title, username, added) VALUES (?, ?, ?, ?, ?)',
             (user_id, group_id, title[:50], username, datetime.now().isoformat()))

def add_groups(user_id, groups):
    count = 0
    for g in groups:
        try:
            db_query(
                'INSERT OR IGNORE INTO groups (user_id, group_id, title, username, added) VALUES (?, ?, ?, ?, ?)',
                (user_id, g['id'], g['title'][:50], g.get('username', ''), datetime.now().isoformat())
            )
            count += 1
        except:
            pass
    return count

def get_groups(user_id):
    rows = db_query('SELECT group_id, title, username, sent FROM groups WHERE user_id = ? ORDER BY title',
                    (user_id,), fetchall=True)
    return [{'id': r[0], 'title': r[1], 'username': r[2] or '', 'sent': r[3]} for r in rows]

def clear_groups(user_id):
    db_query('DELETE FROM groups WHERE user_id = ?', (user_id,))

def save_payment(user_id, days, amount):
    cur = db_query('INSERT INTO payments (user_id, days, amount, created) VALUES (?, ?, ?, ?)',
                   (user_id, days, amount, datetime.now().isoformat()))
    return cur.lastrowid if hasattr(cur, 'lastrowid') else 0

def get_stats():
    users = db_query('SELECT COUNT(*) FROM users', fetchone=True)[0]
    active = db_query('SELECT COUNT(*) FROM users WHERE has_sub = 1 AND banned = 0', fetchone=True)[0]
    revenue = db_query('SELECT SUM(paid) FROM users', fetchone=True)[0] or 0
    groups = db_query('SELECT COUNT(*) FROM groups', fetchone=True)[0]
    pending = db_query('SELECT COUNT(*) FROM payments WHERE status = "pending"', fetchone=True)[0]
    return {'users': users, 'active': active, 'revenue': revenue, 'groups': groups, 'pending': pending}

def get_users():
    rows = db_query('SELECT id, username, name, sub_type, has_sub, banned FROM users', fetchall=True)
    return [dict(r) for r in rows]

def get_pending():
    rows = db_query('SELECT id, user_id, days, amount, created FROM payments WHERE status = "pending" ORDER BY created',
                    fetchall=True)
    return [dict(r) for r in rows]

def confirm_pay(payment_id):
    row = db_query('SELECT user_id, days, amount FROM payments WHERE id = ? AND status = "pending"',
                   (payment_id,), fetchone=True)
    if not row:
        return False
    extend_sub(row[0], row[1], row[2])
    db_query('UPDATE payments SET status = "confirmed" WHERE id = ?', (payment_id,))
    return True

