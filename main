def menu(user_id):
    btns = [
        [Button.inline("➕ Аккаунт", b"acc"), Button.inline("📋 Импорт", b"import")],
        [Button.inline("👥 Группы", b"groups"), Button.inline("📨 Рассылка", b"send")],
        [Button.inline("🛍️ Подписка", b"sub"), Button.inline("ℹ️ Инфо", b"info")]
    ]
    if user_id in ADMINS:
        btns.append([Button.inline("👑 Админ", b"admin")])
    return btns

