@bot.on(events.CallbackQuery(data=b"send_message"))
async def send_message_cb(event):
    uid = event.sender_id
    if not check_subscription(uid):
        await event.respond("❌ Подписка истекла!", buttons=get_main_menu(uid)); return
    groups = get_user_groups(uid)
    if not groups:
        await event.respond("❌ Нет добавленных групп!", buttons=get_main_menu(uid)); return
    buttons = [[Button.inline("✅ Отправить во все", b"send_all_groups")]]
    for g in groups[:20]:
        buttons.append([Button.inline(f"📌 {truncate_text(g['title'], 25)}", f"select_group_{g['id']}")])
    buttons.append([Button.inline("❌ Отмена", b"cancel_send")])
    await event.respond("📨 ВЫБЕРИТЕ ГРУППЫ", buttons=buttons)
    user_states[uid] = {"action": "send_selecting_groups", "selected": []}

@bot.on(events.CallbackQuery(data=b"send_all_groups"))
async def process_one_time_content_cb(event):
    uid = event.sender_id
    if uid not in user_states or user_states[uid].get("action") != "send_selecting_groups":
        await event.answer("❌ Сессия истекла", alert=True); return
    selected = user_states[uid].get("selected", [])
    all_groups = get_user_groups(uid)
