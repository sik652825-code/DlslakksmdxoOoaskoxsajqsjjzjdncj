@bot.on(events.NewMessage(pattern="/confirm (\\d+)"))
async def admin_confirm_cmd(event):
    if event.sender_id not in ADMIN_IDS: return
    m = re.match(r"/confirm (\d+)", event.text)
    if m and confirm_payment(int(m.group(1)), event.sender_id):
        await event.respond("✅ Подтверждено!")

