# РАБОТА С РЕФЕРАЛАМИ
# ============================================================================
@with_db_connection
def add_referral(conn, referrer_id: int, referred_id: int) -> bool:
    c = conn.cursor()
    c.execute("SELECT id FROM referrals WHERE referrer_id = ? AND referred_id = ?", (referrer_id, referred_id))
    if c.fetchone():
        return False
    
    c.execute("INSERT INTO referrals (referrer_id, referred_id, created_at) VALUES (?, ?, ?)",
              (referrer_id, referred_id, get_timestamp()))
    conn.commit()
    
    c.execute("UPDATE users SET referral_count = referral_count + 1 WHERE user_id = ?", (referrer_id,))
    conn.commit()
    
    settings = safe_json_load(SETTINGS_FILE, {})
    reward_days = settings.get('referral_reward_days', 1)
    if reward_days > 0:
        extend_subscription(referrer_id, reward_days, 0)
        c.execute("UPDATE referrals SET reward_given = 1, reward_amount = ? WHERE referrer_id = ? AND referred_id = ?",
                  (reward_days, referrer_id, referred_id))
        conn.commit()
    
    logger.info(f"👤 Новый реферал: {referred_id} от {referrer_id}")
    return True

@with_db_connection
def get_referrals(conn, user_id: int) -> List[Dict]:
    c = conn.cursor()
    c.execute("""SELECT referred_id, created_at, reward_given, reward_amount 
                 FROM referrals WHERE referrer_id = ? ORDER BY created_at DESC""", (user_id,))
    rows = c.fetchall()
    return [{"referred_id": r[0], "created_at": r[1], "reward_given": bool(r[2]), "reward_amount": r[3] or 0} for r in rows]

# ============================================================================
# СТАТИСТИКА
# ============================================================================
@with_db_connection
def get_stats(conn) -> Dict:
    c = conn.cursor()
    
    c.execute("SELECT COUNT(*) FROM users")
    total_users = c.fetchone()[0]
    
    c.execute("SELECT COUNT(*) FROM users WHERE has_subscription = 1 AND is_banned = 0")
    active_users = c.fetchone()[0]
    
    c.execute("SELECT SUM(total_paid) FROM users")
    revenue = c.fetchone()[0] or 0
    
    c.execute("SELECT COUNT(*) FROM sessions WHERE is_active = 1")
    accounts = c.fetchone()[0]
    
    c.execute("SELECT COUNT(*) FROM groups WHERE is_active = 1")
    groups = c.fetchone()[0]
    
    c.execute("SELECT COUNT(*) FROM payments WHERE status = 'pending'")
    pending = c.fetchone()[0]
    
    c.execute("SELECT COUNT(*) FROM users WHERE is_banned = 1")
    banned = c.fetchone()[0]
    
    today = datetime.now().date().isoformat()
    c.execute("SELECT COUNT(*) FROM send_history WHERE sent_at LIKE ?", (f"{today}%",))
    today_sends = c.fetchone()[0]
    
    c.execute("SELECT COUNT(*) FROM payments WHERE created_at LIKE ? AND status = 'confirmed'", (f"{today}%",))
    today_payments = c.fetchone()[0]
    
    c.execute("SELECT COUNT(*) FROM referrals")
    total_referrals = c.fetchone()[0]
    
    return {
        "total_users": total_users,
        "active_users": active_users,
        "revenue": revenue,
        "accounts": accounts,
        "groups": groups,
        "pending": pending,
        "banned": banned,
        "today_sends": today_sends,
        "today_payments": today_payments,
        "total_referrals": total_referrals
    }

@with_db_connection
def get_weekly_stats(conn) -> Dict:
    week_ago = (datetime.now() - timedelta(days=7)).isoformat()
    
    c = conn.cursor()
    c.execute("SELECT COUNT(*) FROM users WHERE registered_at > ?", (week_ago,))
    new_users = c.fetchone()[0]
    c.execute("SELECT COUNT(*) FROM payments WHERE created_at > ? AND status = 'confirmed'", (week_ago,))
    payments = c.fetchone()[0]
    c.execute("SELECT SUM(amount) FROM payments WHERE created_at > ? AND status = 'confirmed'", (week_ago,))
    revenue = c.fetchone()[0] or 0
    c.execute("SELECT COUNT(*) FROM send_history WHERE sent_at > ?", (week_ago,))
    sends = c.fetchone()[0]
    c.execute("SELECT COUNT(*) FROM referrals WHERE created_at > ?", (week_ago,))
    referrals = c.fetchone()[0]
    
    return {
        "new_users": new_users,
        "payments": payments,
        "revenue": revenue,
        "sends": sends,
        "referrals": referrals
    }

@with_db_connection
def get_user_ranking(conn, limit: int = 10) -> List[Dict]:
    c = conn.cursor()
    c.execute("""SELECT user_id, username, total_paid, referral_count, 
                        (SELECT COUNT(*) FROM send_history WHERE user_id = users.user_id) as sends
                 FROM users 
                 WHERE is_banned = 0
                 ORDER BY total_paid DESC, sends DESC
                 LIMIT ?""", (limit,))
    rows = c.fetchall()
    return [{"user_id": r[0], "username": r[1] or "нет", "total_paid": r[2] or 0, "referrals": r[3] or 0, "sends": r[4] or 0} for r in rows]

# ============================================================================
# ОТПРАВКА СООБЩЕНИЙ
# ============================================================================
async def check_user_channels(user_id: int) -> Tuple[bool, List[str]]:
    required_channels = get_required_channels()
    if not required_channels:
        return True, []
    
    session = get_session(user_id)
    if not session:
        return False, ["Нет аккаунта для проверки подписки"]
    
    try:
        client = TelegramClient(StringSession(session), API_ID, API_HASH)
        await client.connect()
        me = await client.get_me()
        not_subscribed = []
        
        for channel_username in required_channels:
            try:
                clean_username = channel_username.replace('@', '')
                entity = await client.get_entity(clean_username)
                try:
                    await client.get_participant(entity, me.id)
                except (UserNotParticipantError, UserBannedInChannelError):
                    not_subscribed.append(channel_username)
            except Exception:
                not_subscribed.append(channel_username)
        
        await client.disconnect()
        return len(not_subscribed) == 0, not_subscribed
    except Exception as e:
        logger.error(f"❌ Ошибка проверки подписки: {e}")
        return False, ["Ошибка проверки подписки"]

async def send_message_to_groups(user_id: int, groups: List[Dict], text: str, 
                                  image_data: Optional[bytes] = None, 
                                  is_scheduled: bool = False,
                                  schedule_id: int = 0) -> Dict:
    if not check_subscription(user_id):
        return {"success": 0, "fails": 0, "failed_groups": ["Подписка истекла"], "status": "error"}
    
    channels_ok, not_subscribed = await check_user_channels(user_id)
    if not channels_ok:
        return {"success": 0, "fails": 0, "failed_groups": [f"Подпишитесь на каналы: {', '.join(not_subscribed)}"], "status": "error"}
    
    session = get_session(user_id)
    if not session:
        return {"success": 0, "fails": 0, "failed_groups": ["Нет аккаунта"], "status": "error"}
    
    final_text = add_signature(text)
    success = 0
    fails = 0
    failed_groups = []
    status = "completed"
    
    try:
        client = TelegramClient(StringSession(session), API_ID, API_HASH, connection_retries=3)
        await client.connect()
        
        if not await client.is_user_authorized():
            return {"success": 0, "fails": 0, "failed_groups": ["Аккаунт не авторизован"], "status": "error"}
        
        me = await client.get_me()
        
        for idx, group in enumerate(groups[:MAX_SEND_GROUPS]):
            try:
                group_id = int(group['id'])
                group_title = group.get('title') or group.get('username') or str(group_id)
                
                if idx > 0:
                    await asyncio.sleep(RATE_LIMIT_DELAY)
                
                try:
                    entity = await client.get_entity(group_id)
                except:
                    dialogs = await client.get_dialogs()
                    entity = None
                    for dialog in dialogs:
                        if dialog.entity.id == group_id:
                            entity = dialog.entity
                            break
                
                if not entity:
                    raise Exception("Entity не найдено")
                
                try:
                    if hasattr(entity, 'participants_count'):
                        try:
                            await client.get_participant(entity, me.id)
                        except UserNotParticipantError:
                            raise Exception("Пользователь не является участником группы")
                        except UserBannedInChannelError:
                            raise Exception("Пользователь забанен в группе")
                    
                    if image_data:
                        compressed_image = compress_image(image_data)
                        await client.send_file(entity, compressed_image, caption=final_text)
                    else:
                        await client.send_message(entity, final_text)
                    
                    success += 1
                    update_group_last_sent(user_id, group_id)
                    if not is_scheduled:
                        add_to_history(user_id, group_title, group_id, text, "text", "sent")
                    logger.info(f"✅ Отправлено в {group_title}")
                    
                except SlowModeWaitError as e:
                    logger.warning(f"⏳ Slow mode в {group_title}: {e}")
                    await asyncio.sleep(e.seconds + 1)
                    if image_data:
                        await client.send_file(entity, compressed_image, caption=final_text)
                    else:
                        await client.send_message(entity, final_text)
                    success += 1
                    update_group_last_sent(user_id, group_id)
                    if not is_scheduled:
                        add_to_history(user_id, group_title, group_id, text, "text", "sent")
                
                except FloodWaitError as e:
                    wait_time = e.seconds + FLOOD_WAIT_BUFFER
                    logger.warning(f"⏳ Flood wait {wait_time} сек для {group_title}")
                    await asyncio.sleep(wait_time)
                    fails += 1
                    failed_groups.append(group_title)
                    add_to_history(user_id, group_title, group_id, text, "text", "error", f"FloodWait: {e.seconds} сек", 1 if is_scheduled else 0)
                    
                except Exception as e:
                    error_msg = str(e)[:200]
                    fails += 1
                    failed_groups.append(group_title)
                    logger.error(f"❌ Ошибка в {group_title}: {error_msg}")
                    add_to_history(user_id, group_title, group_id, text, "text", "error", error_msg, 1 if is_scheduled else 0)
                    
            except Exception as e:
                fails += 1
                failed_groups.append(group.get('title') or group.get('username') or str(group_id))
                logger.error(f"❌ Ошибка обработки группы: {e}")
        
        await client.disconnect()
        
    except Exception as e:
        logger.error(f"❌ Критическая ошибка: {e}")
        return {"success": 0, "fails": 1, "failed_groups": [str(e)[:100]], "status": "critical_error"}
    
    return {"success": success, "fails": fails, "failed_groups": failed_groups, "status": status}

# ============================================================================
# ОБРАБОТКА ГРУПП ИЗ ССЫЛКИ НА ПАПКУ
# ============================================================================
async def get_groups_from_folder_link(user_id: int, folder_link: str) -> List[Dict]:
    """Получает список групп из ссылки на папку с чатами"""
    session = get_session(user_id)
    if not session:
        return []
    
    try:
        client = TelegramClient(StringSession(session), API_ID, API_HASH)
        await client.connect()
        
        if not await client.is_user_authorized():
            await client.disconnect()
            return []
        
        # Извлекаем ID из ссылки
        # Ссылка на папку обычно имеет вид: https://t.me/folder/123456789
        folder_id = None
        if 't.me/folder/' in folder_link:
            try:
                folder_id = int(folder_link.split('/folder/')[1].split('?')[0])
            except:
                pass
        
        if not folder_id:
            await client.disconnect()
            return []
        
        # Получаем диалоги
        dialogs = await client.get_dialogs()
        groups = []
        
        for dialog in dialogs:
            if dialog.is_group or dialog.is_channel:
                # Проверяем, есть ли у диалога папка
                try:
                    # Получаем информацию о диалоге
                    entity = dialog.entity
                    if hasattr(entity, 'folder_id') and entity.folder_id == folder_id:
                        groups.append({
                            'id': str(entity.id),
                            'title': dialog.name or str(entity.id),
                            'username': dialog.entity.username if hasattr(dialog.entity, 'username') else ''
                        })
                except:
                    pass
        
        await client.disconnect()
        return groups
        
    except Exception as e:
        logger.error(f"❌ Ошибка получения групп из папки: {e}")
        return []

# ============================================================================
# ИНТЕРФЕЙС ВЫБОРА ГРУПП
# ============================================================================
async def show_group_selection(user_id: int, page: int = 0, filter_text: str = ""):
    """Показывает интерфейс выбора групп для рассылки"""
    groups = get_user_groups(user_id)
    
    if not groups:
        await bot.send_message(user_id, 
            "❌ У вас нет добавленных групп.\n\n"
            "Добавьте группы через кнопку '📋 Добавить все группы' или "
            "отправьте ссылку на папку с чатами.",
            buttons=[
                [Button.inline("📋 Добавить все группы", b"add_all_groups")],
                [Button.inline("🔗 Отправить ссылку на папку", b"send_folder_link")],
                [Button.inline("◀️ Назад", b"back_to_main")]
            ]
        )
        return
    
    # Фильтрация групп
    if filter_text:
        groups = [g for g in groups if filter_text.lower() in g.group_title.lower() or 
                  filter_text.lower() in g.group_username.lower()]
    
    # Пагинация (по 10 групп на страницу)
    per_page = 10
    total_pages = (len(groups) + per_page - 1) // per_page
    page = max(0, min(page, total_pages - 1))
    start = page * per_page
    end = min(start + per_page, len(groups))
    page_groups = groups[start:end]
    
    # Получаем выбранные группы
    selected = selected_groups.get(user_id, [])
    all_selected = len(selected) == len(groups)
    
    text = f"📋 ВЫБОР ГРУПП ДЛЯ РАССЫЛКИ\n\n"
    text += f"Всего групп: {len(groups)}\n"
    text += f"Выбрано: {len(selected)}\n"
    text += f"Страница {page + 1} из {max(1, total_pages)}\n\n"
    
    # Строим кнопки для групп
    buttons = []
    
    # Кнопка "Выбрать все"
    if all_selected and groups:
        buttons.append([Button.inline(f"✅ Выбраны все ({len(groups)})", b"clear_all_selected")])
    else:
        buttons.append([Button.inline(f"☑️ Выбрать все ({len(groups)})", b"select_all_groups")])
    
    # Кнопки групп
    for group in page_groups:
        group_id = str(group.group_id)
        is_selected = group_id in selected
        status = "✅" if is_selected else "⬜"
        title = group.group_title[:25] + "..." if len(group.group_title) > 25 else group.group_title
        button_data = f"toggle_group_{group_id}".encode()
        buttons.append([Button.inline(f"{status} {title}", button_data)])
    
    # Навигация и действия
    nav_buttons = []
    if page > 0:
        nav_buttons.append(Button.inline("◀️ Назад", f"group_page_{page - 1}".encode()))
    if page < total_pages - 1:
        nav_buttons.append(Button.inline("Вперед ▶️", f"group_page_{page + 1}".encode()))
    if nav_buttons:
        buttons.append(nav_buttons)
    
    # Кнопка поиска и фильтра
    buttons.append([Button.inline("🔍 Поиск групп", b"search_groups")])
    
    # Кнопка для отправки ссылки на папку
    buttons.append([Button.inline("📁 Загрузить из папки", b"send_folder_link")])
    
    # Кнопки действий
    if selected:
        buttons.append([Button.inline("📨 Отправить выбранные", b"send_selected_groups")])
        buttons.append([Button.inline("🗑️ Очистить выбор", b"clear_all_selected")])
    else:
        buttons.append([Button.inline("📨 Отправить во все группы", b"send_all_groups")])
    
    buttons.append([Button.inline("◀️ Назад", b"back_to_main")])
    
    await bot.send_message(user_id, text, buttons=buttons)

# ============================================================================
# ОБРАБОТЧИКИ КНОПОК
# ============================================================================
@bot.on(events.CallbackQuery)
async def handle_callback(event):
    uid = event.sender_id
    data = event.data.decode()
    
    # Обработка выбора групп
    if data.startswith("toggle_group_"):
        group_id = data.split("_")[2]
        selected = selected_groups.get(uid, [])
        
        if group_id in selected:
            selected.remove(group_id)
        else:
            selected.append(group_id)
        
        selected_groups[uid] = selected
        await show_group_selection(uid)
        await event.answer()
        return
    
    elif data == "select_all_groups":
        groups = get_user_groups(uid)
        selected_groups[uid] = [str(g.group_id) for g in groups]
        await show_group_selection(uid)
        await event.answer("✅ Все группы выбраны")
        return
    
    elif data == "clear_all_selected":
        selected_groups[uid] = []
        await show_group_selection(uid)
        await event.answer("🗑️ Выбор очищен")
        return
    
    elif data.startswith("group_page_"):
        page = int(data.split("_")[2])
        await show_group_selection(uid, page)
        await event.answer()
        return
    
    elif data == "search_groups":
        await bot.send_message(uid, 
            "🔍 Введите текст для поиска групп:\n"
            "(можно искать по названию или юзернейму)",
            buttons=[[Button.inline("◀️ Назад", b"back_to_groups")]]
        )
        user_states[uid] = {"state": "search_groups"}
        await event.answer()
        return
    
    elif data == "send_folder_link":
        await bot.send_message(uid,
            "📁 Отправьте ссылку на папку с чатами.\n\n"
            "Пример: https://t.me/folder/123456789\n\n"
            "Бот автоматически добавит все группы из папки.",
            buttons=[[Button.inline("◀️ Назад", b"back_to_groups")]]
        )
        user_states[uid] = {"state": "folder_link"}
        await event.answer()
        return
    
    elif data == "send_selected_groups":
        selected = selected_groups.get(uid, [])
        if not selected:
            await event.answer("❌ Не выбрано ни одной группы", alert=True)
            return
        
        # Сохраняем выбранные группы и переходим к составлению сообщения
        groups = get_user_groups(uid)
        selected_groups_data = [g for g in groups if str(g.group_id) in selected]
        pending_broadcast[uid] = {
            "groups": [{"id": g.group_id, "title": g.group_title, "username": g.group_username} for g in selected_groups_data],
            "selected_ids": selected
        }
        
        await bot.send_message(uid,
            f"📨 ВЫБРАНО ГРУПП ДЛЯ РАССЫЛКИ: {len(selected)}\n\n"
            "Теперь отправьте текст сообщения.\n"
            "Вы также можете прикрепить изображение.",
            buttons=[[Button.inline("◀️ Назад", b"back_to_groups")]]
        )
        user_states[uid] = {"state": "broadcast_message"}
        await event.answer()
        return
    
    elif data == "send_all_groups":
        groups = get_user_groups(uid)
        if not groups:
            await event.answer("❌ Нет добавленных групп", alert=True)
            return
        
        pending_broadcast[uid] = {
            "groups": [{"id": g.group_id, "title": g.group_title, "username": g.group_username} for g in groups],
            "selected_ids": [str(g.group_id) for g in groups]
        }
        
        await bot.send_message(uid,
            f"📨 ВСЕ ГРУППЫ ДЛЯ РАССЫЛКИ: {len(groups)}\n\n"
            "Теперь отправьте текст сообщения.\n"
            "Вы также можете прикрепить изображение.",
            buttons=[[Button.inline("◀️ Назад", b"back_to_groups")]]
        )
        user_states[uid] = {"state": "broadcast_message"}
        await event.answer()
        return
    
    elif data == "back_to_groups":
        await show_group_selection(uid)
        await event.answer()
        return
    
    elif data == "back_to_main":
        # Очищаем состояния
        user_states.pop(uid, None)
        pending_broadcast.pop(uid, None)
        selected_groups.pop(uid, None)
        days = get_remaining_days(uid)
        sub_type = get_subscription_type(uid)
        await event.edit(
            f"👋 Главное меню\n"
            f"📦 Подписка: {sub_type}\n"
            f"📅 Осталось: {days} дн.",
            buttons=get_main_menu(uid)
        )
        await event.answer()
        return
    
    # ... остальные обработчики кнопок ...
    elif data == "send_message":
        await show_group_selection(uid)
        await event.answer()
        return

# ============================================================================
# ОБРАБОТКА СООБЩЕНИЙ
# ============================================================================
@bot.on(events.NewMessage)
async def handle_messages(event):
    uid = event.sender_id
    if not event.text and not event.media:
        return
    
    text = event.text or ""
    
    # Проверяем состояние поиска групп
    if uid in user_states and user_states[uid].get("state") == "search_groups":
        filter_text = text.strip()
        await show_group_selection(uid, 0, filter_text)
        user_states.pop(uid, None)
        return
    
    # Проверяем состояние для ссылки на папку
    if uid in user_states and user_states[uid].get("state") == "folder_link":
        if "t.me/folder/" in text:
            await event.respond("⏳ Загружаем группы из папки...")
            groups = await get_groups_from_folder_link(uid, text)
            
            if groups:
                added_count = 0
                for g in groups:
                    try:
                        if add_group(uid, int(g['id']), g['username'], g['title']):
                            added_count += 1
                    except:
                        pass
                
                await event.respond(f"✅ Добавлено {added_count} групп из папки")
                await show_group_selection(uid)
            else:
                await event.respond("❌ Не удалось найти группы в папке")
        else:
            await event.respond("❌ Неверная ссылка на папку. Пример: https://t.me/folder/123456789")
        
        user_states.pop(uid, None)
        return
    
    # Проверяем состояние для сообщения рассылки
    if uid in user_states and user_states[uid].get("state") == "broadcast_message":
        broadcast_data = pending_broadcast.get(uid)
        if not broadcast_data:
            await event.respond("❌ Данные рассылки потеряны. Начните заново.")
            user_states.pop(uid, None)
            return
        
        # Получаем текст и изображение
        message_text = text
        image_data = None
        
        if event.media:
            if event.photo:
                try:
                    file = await event.download_media(bytes)
                    image_data = file
                except Exception as e:
                    logger.error(f"❌ Ошибка загрузки фото: {e}")
                    await event.respond("⚠️ Не удалось загрузить изображение. Отправьте текст или другое изображение.")
                    return
        
        if not message_text and not image_data:
            await event.respond("📝 Отправьте текст сообщения или текст с изображением.")
            return
        
        # Сохраняем данные рассылки
        broadcast_data['message'] = message_text
        broadcast_data['image_data'] = image_data
        
        # Подтверждение
        groups_count = len(broadcast_data['groups'])
        has_image = "📷 с изображением" if image_data else "📝 текстовое"
        
        await event.respond(
            f"📨 ПОДТВЕРДИТЕ РАССЫЛКУ\n\n"
            f"Групп: {groups_count}\n"
            f"Тип: {has_image}\n"
            f"Сообщение:\n{message_text[:200]}{'...' if len(message_text) > 200 else ''}\n\n"
            f"✅ Начинаем рассылку?",
            buttons=[
                [Button.inline("✅ Начать рассылку", b"confirm_broadcast")],
                [Button.inline("❌ Отмена", b"cancel_broadcast")]
            ]
        )
        user_states[uid] = {"state": "broadcast_confirm"}
        return
    
    # Остальные обработчики...
    if text.startswith("/start") or text.startswith("/panel"):
        return
    
    # Если пользователь не в состоянии - показываем меню
    if uid not in user_states:
        days = get_remaining_days(uid)
        sub_type = get_subscription_type(uid)
        await event.respond(
            f"👋 Главное меню\n"
            f"📦 Подписка: {sub_type}\n"
            f"📅 Осталось: {days} дн.",
            buttons=get_main_menu(uid)
        )

# ============================================================================
# ОБРАБОТЧИКИ ПОДТВЕРЖДЕНИЯ РАССЫЛКИ
# ============================================================================
@bot.on(events.CallbackQuery)
async def handle_broadcast_confirm(event):
    uid = event.sender_id
    data = event.data.decode()
    
    if data == "confirm_broadcast":
        broadcast_data = pending_broadcast.get(uid)
        if not broadcast_data:
            await event.edit("❌ Данные рассылки потеряны")
            return
        
        groups = broadcast_data.get('groups', [])
        message = broadcast_data.get('message', '')
        image_data = broadcast_data.get('image_data')
        
        if not groups or not message:
            await event.edit("❌ Недостаточно данных для рассылки")
            return
        
        await event.edit("⏳ Запуск рассылки...")
        
        # Запускаем рассылку
        result = await send_message_to_groups(uid, groups, message, image_data)
        
        if result["status"] == "error":
            await event.edit(f"❌ Ошибка: {result.get('failed_groups', ['Неизвестная ошибка'])[0]}")
        else:
            await event.edit(
                f"✅ РАССЫЛКА ЗАВЕРШЕНА\n\n"
                f"📨 Отправлено: {result['success']}\n"
                f"❌ Ошибок: {result['fails']}\n"
                f"{'⚠️ Группы с ошибками: ' + ', '.join(result['failed_groups'][:5]) if result['failed_groups'] else ''}"
            )
        
        # Очищаем данные
        pending_broadcast.pop(uid, None)
        user_states.pop(uid, None)
        selected_groups.pop(uid, None)
        return
    
    elif data == "cancel_broadcast":
        pending_broadcast.pop(uid, None)
        user_states.pop(uid, None)
        selected_groups.pop(uid, None)
        await event.edit("❌ Рассылка отменена")
        days = get_remaining_days(uid)
        sub_type = get_subscription_type(uid)
        await event.respond(
            f"👋 Главное меню\n"
            f"📦 Подписка: {sub_type}\n"
            f"📅 Осталось: {days} дн.",
            buttons=get_main_menu(uid)
        )
        return

# ============================================================================
# МЕНЮ
# ============================================================================
def get_main_menu(user_id: int) -> List[List]:
    is_admin = user_id in ADMIN_IDS
    buttons = [
        [Button.inline("➕ Добавить аккаунт", b"add_account"), Button.inline("👤 Мои аккаунты", b"my_accounts")],
        [Button.inline("📋 Добавить все группы", b"add_all_groups"), Button.inline("👥 Мои группы", b"my_groups")],
        [Button.inline("📨 Рассылка", b"send_message"), Button.inline("📊 История", b"show_history")],
        [Button.inline("🛍️ Купить подписку", b"buy_subscription"), Button.inline("ℹ️ Инфо", b"info")]
    ]
    if is_admin:
        buttons.append([Button.inline("👑 Админ панель", b"admin_panel")])
    return buttons

def get_admin_menu() -> List[List]:
    return [
        [Button.inline("📊 Статистика", b"admin_stats"), Button.inline("👥 Пользователи", b"admin_users")],
        [Button.inline("💳 Платежи", b"admin_payments"), Button.inline("📢 Объявления", b"admin_broadcast")],
        [Button.inline("📋 Каналы", b"admin_channels"), Button.inline("🎯 Спонсоры", b"admin_sponsors")],
        [Button.inline("⚙️ Настройки", b"admin_settings"), Button.inline("📜 Логи", b"admin_logs")],
        [Button.inline("◀️ Назад", b"back_to_main")]
    ]

# ============================================================================
# ЗАПУСК БОТА
# ============================================================================
async def main():
    """Главная функция запуска бота"""
    # Инициализация
    init_database()
    init_sponsors()
    init_required_channels()
    init_settings()
    init_templates()
    init_blacklist()
    
    # Запуск бота
    await bot.start(bot_token=BOT_TOKEN)
    logger.info("🚀 Бот запущен!")
    
    # Запуск планировщика
    scheduler.start()
    
    # Уведомление админам
    for admin_id in ADMIN_IDS:
        try:
            await bot.send_message(admin_id, f"🚀 Бот @{BOT_USERNAME} запущен!\nВерсия: {VERSION}")
        except:
            pass
    
    await bot.run_until_disconnected()

if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        logger.info("🛑 Бот остановлен")
    except Exception as e:
        logger.error(f"❌ Критическая ошибка: {e}")
        traceback.print_exc()
