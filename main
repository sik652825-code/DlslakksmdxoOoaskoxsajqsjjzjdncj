# ============================================================================
# ВСПОМОГАТЕЛЬНЫЕ
# ============================================================================
def fmt(n):
    return f"{n:,}".replace(",", " ") if n else "0"

def trunc(t, n=100):
    return t[:n-3] + "..." if len(t) > n else t

def sig(t):
    s = f"\n\n📢 @{BOT_NAME} | v{VERSION}"
    return t[:4096-len(s)-10] + s if len(t) + len(s) > 4096 else t + s

# ============================================================================
# КЛИЕНТ
# ============================================================================
async def get_client(user_id):
    if user_id in clients:
        c = clients[user_id]
        if c.is_connected():
            return c
    session = get_session(user_id)
    if not session:
        return None
    c = TelegramClient(StringSession(session), API_ID, API_HASH)
    await c.connect()
    if await c.is_user_authorized():
        clients[user_id] = c
        return c
    await c.disconnect()
    return None

# ============================================================================
# ОТПРАВКА
# ============================================================================
async def send_groups(user_id, groups, text, image=None):
    if not has_sub(user_id):
        return 0, 0, ["Подписка истекла"]
    
    client = await get_client(user_id)
    if not client:
        return 0, 0, ["Нет аккаунта"]
    
    text = sig(text)
    ok, fail, failed = 0, 0, []
    
    for i, g in enumerate(groups[:200]):
        try:
            if i > 0:
                await asyncio.sleep(2)
            entity = await client.get_entity(int(g['id']))
            if image:
                await client.send_file(entity, image, caption=text)
            else:
                await client.send_message(entity, text)
            ok += 1
            db_query('UPDATE groups SET sent = sent + 1 WHERE user_id = ? AND group_id = ?',
                     (user_id, int(g['id'])))
            db_query('INSERT INTO history (user_id, group_title, sent_at, text, status) VALUES (?, ?, ?, ?, ?)',
                     (user_id, g['title'][:30], datetime.now().isoformat(), text[:100], 'sent'))
        except FloodWaitError as e:
            await asyncio.sleep(e.seconds + 5)
            fail += 1
            failed.append(g['title'])
        except Exception as e:
            fail += 1
            failed.append(g['title'])
            logger.error(f"Ошибка в {g['title']}: {e}")
    
    return ok, fail, failed

# ============================================================================
# ИМПОРТ
# ============================================================================
async def import_groups(user_id):
    client = await get_client(user_id)
    if not client:
        return []
    try:
        dialogs = await client.get_dialogs()
        groups = []
        for d in dialogs:
            if d.is_group or d.is_channel:
                if d.entity.id > 0:
                    groups.append({
                        'id': d.entity.id,
                        'title': d.name or str(d.entity.id),
                        'username': getattr(d.entity, 'username', '')
                    })
        return groups
    except Exception as e:
        logger.error(f"Ошибка импорта: {e}")
        return []

