        user_states[uid] = {"state": "payment_confirm"}
        await event.answer()
        return
    
    # История
    if data == "show_history":
        history = get_user_stats(uid)
        text = f"📊 ИСТОРИЯ\n\n"
        text += f"📨 Отправок: {history['total_sends']}\n"
        text += f"❌ Ошибок: {history['error_sends']}\n"
        text += f"👥 Групп: {history['total_groups']}\n"
        text += f"💳 Платежей: {history['total_payments']}\n"
        text += f"💰 Потрачено: {history['total_spent']} руб"
        
        await event.edit(text, buttons=[[Button.inline("◀️ Назад", b"back_to_main")]])
