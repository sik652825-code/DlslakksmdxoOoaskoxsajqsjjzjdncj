        text += f"💳 Реквизиты:\nКарта: {CARD_NUMBER}\nПолучатель: {CARD_HOLDER}\n"
        text += f"💬 Комментарий: {payment_id}\n\n📝 После оплаты отправьте скриншот"
        
        await event.edit(text, buttons=[
            [Button.inline("✅ Я оплатил", b"payment_confirmed")],
            [Button.inline("◀️ Назад", b"buy_subscription")]
        ])
        return
    
    if data == "payment_confirmed":
        await bot.send_message(uid,
            "📝 Отправьте скриншот платежа.\nАдминистратор подтвердит оплату.",
            buttons=[[Button.inline("◀️ Назад", b"buy_subscription")]]
