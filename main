@bot.on(events.CallbackQuery(data=b"auto_send_menu"))
async def auto_send_menu_cb(event):
    uid = event.sender_id
    
    if uid in running_loops:
        await event.respond(
            "🔄 АВТОРАССЫЛКА УЖЕ ЗАПУЩЕНА!\n\nНажмите кнопку ниже, чтобы остановить бесконечный цикл.",
            buttons=[[Button.inline("⏹ ОСТАНОВИТЬ ЦИКЛ", b"stop_auto_loop")]]
        )
        return
        
    if not check_subscription(uid):
        await event.respond("❌ Подписка истекла!", buttons=get_main_menu(uid))
        return
    
    groups = get_user_groups(uid)
    if not groups:
        await event.respond("❌ Нет добавленных групп! Добавьте группы через меню.", buttons=get_main_menu(uid))
        return
    
    buttons = []
    for g in groups[:20]:
        title = truncate_text(g['title'] or f"Группа {g['id']}", 25)
        buttons.append([Button.inline(f"📌 {title}", f"auto_group_{g['id']}")])
    
    # КНОПКА ДАЛЕЕ ТЕПЕРЬ ПОЯВЛЯЕТСЯ!
    buttons.append([Button.inline("✅ Выбрать все", b"auto_select_all")])
    buttons.append([Button.inline("✅ Далее", b"auto_next_step")])
    buttons.append([Button.inline("❌ Отмена", b"cancel_select")])
    
    await event.respond(
        f"🔄 АВТОРАССЫЛКА (БЕСКОНЕЧНЫЙ ЦИКЛ)\n\n"
        f"Выберите группы. После выбора нажмите '✅ Далее'.\n"
        f"⚠️ МИНИМАЛЬНЫЙ ИНТЕРВАЛ: 5 МИНУТ!",
        buttons=buttons
    )
    user_states[uid] = {"action": "auto_selecting_groups", "selected": []}

@bot.on(events.CallbackQuery(func=lambda e: e.data.startswith(b"auto_group_")))
async def auto_select_group_cb(event):
    uid = event.sender_id
    # ИСПРАВЛЕНИЕ: везде используем event.data вместо ошибочного e.data
    gid = int(event.data.decode().split("_")[2])
    if uid not in user_states or user_states[uid].get("action") != "auto_selecting_groups":
        await event.answer("❌ Сессия истекла", alert=True); return
    selected = user_states[uid].get("selected", [])
    if gid in selected:
        selected.remove(gid); await event.answer("❌ Удалено")
    else:
        selected.append(gid); await event.answer("✅ Добавлено")
    user_states[uid]["selected"] = selected

@bot.on(events.CallbackQuery(data=b"auto_select_all"))
async def auto_select_all_cb(event):
    uid = event.sender_id
    if uid not in user_states:
        await event.answer("❌ Сессия истекла", alert=True); return
    
    groups = get_user_groups(uid)
    user_states[uid]["selected"] = [g['id'] for g in groups]
    
    # ИСПРАВЛЕНИЕ: АВТОМАТИЧЕСКИ ПЕРЕХОДИМ К СЛЕДУЮЩЕМУ ШАГУ
    await event.answer(f"✅ Выбрано {len(groups)} групп. Переход к следующему шагу.", alert=True)
    
    # Формируем список групп
    selected_ids = user_states[uid]["selected"]
    groups_to_send = [g for g in groups if g['id'] in selected_ids]
    
    user_states[uid] = {"action": "auto_wait_for_msg", "groups": groups_to_send}
    await event.respond(
        f"🔄 АВТОРАССЫЛКА\n\n"
        f"👥 Выбрано групп: {len(groups_to_send)}\n\n"
        f"📝 Отправьте текст или изображение для циклической рассылки.\n"
        f"⚠️ Подпись будет добавлена автоматически.",
        buttons=[[Button.inline("❌ Отмена", b"cancel_send")]]
    )

@bot.on(events.CallbackQuery(data=b"auto_next_step"))
async def auto_next_step_cb(event):
    uid = event.sender_id
    if uid not in user_states or user_states[uid].get("action") != "auto_selecting_groups":
        await event.answer("❌ Сессия истекла", alert=True); return
    
    selected = user_states[uid].get("selected", [])
    all_groups = get_user_groups(uid)
    groups_to_send = [g for g in all_groups if g['id'] in selected]
    
    if not groups_to_send:
        await event.respond("❌ Вы не выбрали ни одной группы! Выберите хотя бы одну.", buttons=get_main_menu(uid))
        if uid in user_states: del user_states[uid]
        return
    
    user_states[uid] = {"action": "auto_wait_for_msg", "groups": groups_to_send}
    await event.respond(
        f"🔄 АВТОРАССЫЛКА\n\n"
        f"👥 Выбрано групп: {len(groups_to_send)}\n\n"
        f"📝 Отправьте текст или изображение для циклической рассылки.\n"
        f"⚠️ Подпись будет добавлена автоматически.",
        buttons=[[Button.inline("❌ Отмена", b"cancel_send")]]
    )

@bot.on(events.NewMessage(func=lambda e: e.sender_id in user_states and user_states[e.sender_id].get("action") == "auto_wait_for_msg"))
async def process_auto_message(event):
    uid = event.sender_id
    groups = user_states[uid].get("groups", [])
    text = event.text.strip() if event.text else (event.caption or "")
    
    if not text:
        await event.respond("❌ Пожалуйста, отправьте текст сообщения для рассылки.")
        return
    
    if not groups:
        await event.respond("❌ Ошибка: группы не найдены. Начните заново.", buttons=get_main_menu(uid))
        if uid in user_states: del user_states[uid]
        return

    user_states[uid] = {
        "action": "auto_choose_delay",
        "groups": groups,
        "message": text,
        "next_action": "start_auto_loop"
    }
    
    await event.respond(
        f"🔄 ВЫБЕРИТЕ ИНТЕРВАЛ МЕЖДУ ЦИКЛАМИ\n\n"
        f"📝 Текст: {truncate_text(text, 100)}\n"
        f"👥 Групп: {len(groups)}\n\n"
        f"⏱️ Мин. интервал: 5 минут (для безопасности)\n"
        f"Выберите задержку МЕЖДУ ЦИКЛАМИ:",
        buttons=get_delay_menu()
    )

@bot.on(events.CallbackQuery(func=lambda e: e.data.startswith(b"delay_")))
async def auto_delay_choice_cb(event):
    uid = event.sender_id
    seconds = int(event.data.decode().split("_")[1])
    
    if uid not in user_states or user_states[uid].get("action") != "auto_choose_delay":
        await event.answer("❌ Сессия истекла", alert=True); return
    
    groups = user_states[uid]["groups"]
    message = user_states[uid]["message"]
    
    if uid in user_states: del user_states[uid]
    
    await event.respond(f"🔄 ЗАПУСК АВТОРАССЫЛКИ!\n\nИнтервал между циклами: {seconds} сек.\nГрупп в цикле: {len(groups)}.\n\n✅ Запущено! Чтобы остановить, нажмите '🔄 Авторассылка' в меню.")
    
    stop_flag = False
    task = asyncio.create_task(auto_loop_task(uid, groups, message, seconds))
    running_loops[uid] = {'task': task, 'stop_flag': stop_flag}

@bot.on(events.CallbackQuery(data=b"stop_auto_loop"))
async def stop_auto_loop_cb(event):
    uid = event.sender_id
    if uid in running_loops:
        stop_auto_loop(uid)
        await event.respond("⏹️ Авторассылка остановлена.", buttons=get_main_menu(uid))
    else:
        await event.respond("⚠️ Активный цикл не найден.", buttons=get_main_menu(uid))

