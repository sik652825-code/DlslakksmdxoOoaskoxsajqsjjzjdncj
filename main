@bot.on(events.CallbackQuery(data=b"add_account"))
async def add_account_cb(event):
    await event.respond("📱 Отправьте номер телефона через кнопку ниже.", buttons=[[Button.request_phone("📱 Отправить номер", resize=True)]])
    phone_waiting[event.sender_id] = True

@bot.on(events.NewMessage(func=lambda e: e.sender_id in phone_waiting and e.contact))
async def process_phone(event):
    uid, phone = event.sender_id, event.contact.phone_number
    if not phone.startswith("+"): phone = "+" + phone
    client = TelegramClient(StringSession(), API_ID, API_HASH, connection_retries=5)
    user_clients[uid] = client; user_phones[uid] = phone
    try:
        await client.connect()
        if await client.is_user_authorized():
            save_session(uid, client.session.save()); activate_beta_subscription(uid)
            await event.respond("✅ Аккаунт добавлен! + БЕТА подписка!", buttons=get_main_menu(uid))
            if uid in phone_waiting: del phone_waiting[uid]; return
        await client.send_code_request(phone)
        code_waiting[uid] = phone
        if uid in phone_waiting: del phone_waiting[uid]
        await event.respond("📱 Введите код из Telegram:", buttons=[
            [Button.inline("1", b"code_1"), Button.inline("2", b"code_2"), Button.inline("3", b"code_3")],
            [Button.inline("4", b"code_4"), Button.inline("5", b"code_5"), Button.inline("6", b"code_6")],
            [Button.inline("7", b"code_7"), Button.inline("8", b"code_8"), Button.inline("9", b"code_9")],
            [Button.inline("⌫ Удалить", b"code_backspace"), Button.inline("0", b"code_0"), Button.inline("✅ Готово", b"code_done")]
        ]); user_temp_codes[uid] = ""
    except Exception as e: await event.respond(f"❌ Ошибка: {str(e)[:200]}")

@bot.on(events.CallbackQuery(func=lambda e: e.data.startswith(b"code_")))
async def process_code(event):
    uid = event.sender_id
    action = event.data.decode()
    if action == "code_backspace": user_temp_codes[uid] = user_temp_codes[uid][:-1]
    elif action == "code_done":
        code = user_temp_codes[uid]
        if len(code) < 5: await event.answer("❌ Минимум 5 цифр!", alert=True); return
        try:
            await user_clients[uid].sign_in(user_phones[uid], code)
            save_session(uid, user_clients[uid].session.save())
            await event.respond("✅ Аккаунт добавлен!", buttons=get_main_menu(uid))
            for key in [code_waiting, user_clients, user_temp_codes, user_phones]:
                if uid in key: del key[uid]
        except SessionPasswordNeededError:
            await event.respond("🔐 Введите пароль 2FA (текстом):")
            password_waiting[uid] = user_clients[uid]
        except Exception as e: await event.respond(f"❌ Ошибка кода: {str(e)[:200]}"); user_temp_codes[uid] = ""
        return
    else: user_temp_codes[uid] += action.split("_")[1]
    try: await event.edit(f"📱 Введите код: `{user_temp_codes[uid]}`", buttons=[
        [Button.inline("1", b"code_1"), Button.inline("2", b"code_2"), Button.inline("3", b"code_3")],
        [Button.inline("4", b"code_4"), Button.inline("5", b"code_5"), Button.inline("6", b"code_6")],
        [Button.inline("7", b"code_7"), Button.inline("8", b"code_8"), Button.inline("9", b"code_9")],
        [Button.inline("⌫ Удалить", b"code_backspace"), Button.inline("0", b"code_0"), Button.inline("✅ Готово", b"code_done")]
    ])
    except: pass

@bot.on(events.NewMessage(func=lambda e: e.sender_id in password_waiting))
async def process_password(event):
    uid = event.sender_id
    try:
        await password_waiting[uid].sign_in(password=event.text.strip())
        save_session(uid, password_waiting[uid].session.save())
        await event.respond("✅ Аккаунт добавлен!", buttons=get_main_menu(uid))
        del password_waiting[uid]
    except Exception as e: await event.respond(f"❌ Ошибка пароля: {str(e)[:100]}")

