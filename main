# ============================================================================
# ПОКАЗ ВЫБОРА ГРУПП
# ============================================================================
async def show_group_selection(user_id: int, page: int = 0, filter_text: str = ""):
    groups = get_user_groups(user_id)
    
    if not groups:
        await bot.send_message(user_id, 
            "❌ У вас нет добавленных групп.\n\n"
            "Импортируйте группы через кнопку '📋 Импорт групп'",
            buttons=[
                [Button.inline("📋 Импорт групп", b"import_groups")],
                [Button.inline("◀️ Назад", b"back_to_main")]
            ]
        )
        return
    
    if filter_text:
        groups = [g for g in groups if filter_text.lower() in g.group_title.lower()]
    
    per_page = 10
    total_pages = (len(groups) + per_page - 1) // per_page
    page = max(0, min(page, total_pages - 1))
    start = page * per_page
    end = min(start + per_page, len(groups))
    page_groups = groups[start:end]
    
    selected = selected_groups.get(user_id, [])
    
    text = f"📋 ВЫБОР ГРУПП\n\n"
    text += f"Всего: {len(groups)}\n"
    text += f"Выбрано: {len(selected)}\n"
    text += f"Страница {page + 1} из {max(1, total_pages)}\n\n"
    
    buttons = []
    
    if len(selected) == len(groups) and groups:
        buttons.append([Button.inline(f"✅ Выбраны все ({len(groups)})", b"clear_all")])
    else:
        buttons.append([Button.inline(f"☑️ Выбрать все", b"select_all")])
    
    for group in page_groups:
        group_id = str(group.group_id)
        is_selected = group_id in selected
        status = "✅" if is_selected else "⬜"
        title = group.group_title[:25] + "..." if len(group.group_title) > 25 else group.group_title
        buttons.append([Button.inline(f"{status} {title}", f"toggle_{group_id}".encode())])
    
    nav_buttons = []
    if page > 0:
        nav_buttons.append(Button.inline("◀️", f"page_{page - 1}".encode()))
    if page < total_pages - 1:
        nav_buttons.append(Button.inline("▶️", f"page_{page + 1}".encode()))
    if nav_buttons:
        buttons.append(nav_buttons)
    
    buttons.append([Button.inline("🔍 Поиск", b"search_groups")])
    
    if selected:
        buttons.append([Button.inline("📨 Отправить выбранные", b"send_selected")])
        buttons.append([Button.inline("🗑️ Очистить выбор", b"clear_all")])
    else:
        buttons.append([Button.inline("📨 Отправить во все", b"send_all")])
    
    buttons.append([Button.inline("◀️ Назад", b"back_to_main")])
    
    await bot.send_message(user_id, text, buttons=buttons)

# ============================================================================
# ОБРАБОТЧИКИ КНОПОК
# ============================================================================
@bot.on(events.CallbackQuery)
async def handle_callback(event):
    uid = event.sender_id
    data = event.data.decode()
    
    # Навигация по группам
    if data.startswith("page_"):
        page = int(data.split("_")[1])
        await show_group_selection(uid, page)
        await event.answer()
        return
    
    if data.startswith("toggle_"):
        group_id = data.split("_")[1]
        selected = selected_groups.get(uid, [])
        if group_id in selected:
            selected.remove(group_id)
        else:
            selected.append(group_id)
        selected_groups[uid] = selected
        await show_group_selection(uid)
        await event.answer()
        return
    
    if data == "select_all":
        groups = get_user_groups(uid)
        selected_groups[uid] = [str(g.group_id) for g in groups]
        await show_group_selection(uid)
        await event.answer("✅ Все группы выбраны")
        return
    
    if data == "clear_all":
        selected_groups[uid] = []
        await show_group_selection(uid)
        await event.answer("🗑️ Выбор очищен")
        return
    
    if data == "search_groups":
        await bot.send_message(uid, "🔍 Введите текст для поиска групп:", 
            buttons=[[Button.inline("◀️ Назад", b"back_to_groups")]])
        user_states[uid] = {"state": "search_groups"}
        await event.answer()
        return
    
    if data == "back_to_groups":
        await show_group_selection(uid)
        await event.answer()
        return
    
    # Рассылка
    if data == "send_message":
        await show_group_selection(uid)
        await event.answer()
        return
    
    if data == "send_selected":
        selected = selected_groups.get(uid, [])
        if not selected:
            await event.answer("❌ Не выбрано ни одной группы", alert=True)
            return
        
        groups = get_user_groups(uid)
        selected_groups_data = [{"id": g.group_id, "title": g.group_title} for g in groups if str(g.group_id) in selected]
        pending_broadcast[uid] = {"groups": selected_groups_data}
        
        await bot.send_message(uid,
            f"📨 ВЫБРАНО ГРУПП: {len(selected)}\n\n"
            "Отправьте текст сообщения.\n"
            "Можно прикрепить изображение.",
            buttons=[[Button.inline("◀️ Назад", b"back_to_groups")]]
        )
        user_states[uid] = {"state": "broadcast_message"}
        await event.answer()
        return
    
    if data == "send_all":
        groups = get_user_groups(uid)
        if not groups:
            await event.answer("❌ Нет групп", alert=True)
            return
        
        pending_broadcast[uid] = {"groups": [{"id": g.group_id, "title": g.group_title} for g in groups]}
        
        await bot.send_message(uid,
            f"📨 ВСЕ ГРУППЫ: {len(groups)}\n\n"
            "Отправьте текст сообщения.\n"
            "Можно прикрепить изображение.",
            buttons=[[Button.inline("◀️ Назад", b"back_to_groups")]]
        )
        user_states[uid] = {"state": "broadcast_message"}
        await event.answer()
        return
    
    if data == "confirm_broadcast":
        broadcast_data = pending_broadcast.get(uid)
        if not broadcast_data:
            await event.edit("❌ Данные рассылки потеряны")
            return
        
        groups = broadcast_data.get('groups', [])
        message = broadcast_data.get('message', '')
        image_data = broadcast_data.get('image_data')
        
        if not groups or not message:
            await event.edit("❌ Недостаточно данных")
            return
        
        await event.edit("⏳ Запуск рассылки...")
        result = await send_message_to_groups(uid, groups, message, image_data)
        
        text = f"✅ РАССЫЛКА ЗАВЕРШЕНА\n\n📨 Отправлено: {result['success']}\n❌ Ошибок: {result['fails']}"
        if result['failed_groups']:
            text += f"\n⚠️ Ошибки: {', '.join(result['failed_groups'][:5])}"
        
        await event.edit(text)
        pending_broadcast.pop(uid, None)
        user_states.pop(uid, None)
        selected_groups.pop(uid, None)
        return
    
    if data == "cancel_broadcast":
        pending_broadcast.pop(uid, None)
        user_states.pop(uid, None)
        await event.edit("❌ Рассылка отменена")
        await event.respond("👋 Главное меню", buttons=get_main_menu(uid))
        return
    
    # Импорт групп
    if data == "import_groups":
        await bot.send_message(uid,
            "📋 ИМПОРТ ГРУПП\n\n"
            "Выберите способ:",
            buttons=[
                [Button.inline("📋 Все группы из аккаунта", b"import_all")],
                [Button.inline("◀️ Назад", b"back_to_main")]
            ]
        )
        await event.answer()
        return
    
    if data == "import_all":
        await event.edit("⏳ Загрузка групп...")
        groups = await get_user_groups_from_telegram(uid)
        
        if not groups:
            await event.edit("❌ Не найдено ни одной группы")
            return
        
        added = add_groups_batch(uid, groups)
        await event.edit(f"✅ Добавлено {added} групп из {len(groups)}")
        await asyncio.sleep(1)
        await event.respond("👋 Главное меню", buttons=get_main_menu(uid))
        return
    
    # Группы
    if data == "my_groups":
        groups = get_user_groups(uid)
        if not groups:
            await event.edit("❌ У вас нет групп", buttons=[[Button.inline("◀️ Назад", b"back_to_main")]])
            return
        
        text = f"👥 МОИ ГРУППЫ ({len(groups)})\n\n"
        for g in groups[:20]:
            text += f"📌 {g.group_title[:30]} - {g.send_count} отправок\n"
        
        if len(groups) > 20:
            text += f"\n... и еще {len(groups) - 20} групп"
        
        buttons = [
            [Button.inline("🗑️ Очистить группы", b"clear_groups")],
            [Button.inline("◀️ Назад", b"back_to_main")]
        ]
        await event.edit(text, buttons=buttons)
        return
    
    if data == "clear_groups":
        clear_user_groups(uid)
        await event.edit("✅ Все группы удалены", buttons=[[Button.inline("◀️ Назад", b"back_to_main")]])
        return
    
    # Подписка
    if data == "buy_subscription":
        days = get_remaining_days(uid)
        sub_type = get_subscription_type(uid)
        
        text = f"🛍️ ПОДПИСКА\n\n📦 Текущая: {sub_type}\n📅 Осталось: {days} дн.\n\n"
        text += "💰 ЦЕНЫ:\n🎁 Пробная - БЕСПЛАТНО (3 дня)\n"
        text += "📦 Базовая - 450 руб (30 дней)\n"
        text += "⭐ PREMIUM - 599 руб (90 дней)\n"
        text += "💎 VIP - 1499 руб (365 дней)\n"
        text += "👑 НАВСЕГДА - 1999 руб\n\n"
        text += f"💳 Карта: {CARD_NUMBER}\nПолучатель: {CARD_HOLDER}"
        
        await event.edit(text, buttons=get_subscription_menu())
        return
    
    if data == "trial_subscription":
        if activate_trial(uid):
            await event.edit("✅ Пробная подписка активирована на 3 дня!")
        else:
            await event.edit("❌ Пробная подписка уже использована")
        await asyncio.sleep(1)
        await event.respond("👋 Главное меню", buttons=get_main_menu(uid))
        return
    
    if data.startswith("buy_"):
        days_map = {"buy_30": 30, "buy_90": 90, "buy_365": 365, "buy_forever": 9999}
        price_map = {"buy_30": 450, "buy_90": 599, "buy_365": 1499, "buy_forever": 1999}
        
        days = days_map.get(data, 0)
