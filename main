@bot.on(events.CallbackQuery)
async def callback(event):
    uid = event.sender_id
    data = event.data.decode()
    
    # Аккаунт
    if data == "acc":
        await event.respond("📱 Введите номер: +7XXXXXXXXXX")
        states[uid] = "phone"
        await event.answer()
        return
    
    # Импорт
    if data == "import":
        await event.edit("⏳ Загрузка...")
        groups = await import_groups(uid)
        if groups:
            added = add_groups(uid, groups)
            await event.edit(f"✅ Добавлено {added} групп")
        else:
            await event.edit("❌ Нет групп")
        await asyncio.sleep(1)
        st, days = get_sub(uid)
        await event.respond(f"👋 Меню\n📦 {st} | {days} дн.", buttons=menu(uid))
        return
    
    # Группы
    if data == "groups":
        groups = get_groups(uid)
        if not groups:
            await event.edit("❌ Нет групп", buttons=[[Button.inline("◀️ Назад", b"back")]])
            return
        text = f"👥 ГРУППЫ ({len(groups)})\n\n"
        for g in groups[:20]:
            text += f"📌 {g['title'][:25]} - {g['sent']} отправок\n"
        if len(groups) > 20:
            text += f"\n... и еще {len(groups)-20}"
        await event.edit(text, buttons=[[Button.inline("🗑️ Очистить", b"clear")], [Button.inline("◀️ Назад", b"back")]])
        return
    
    if data == "clear":
        clear_groups(uid)
        await event.edit("✅ Очищено", buttons=[[Button.inline("◀️ Назад", b"back")]])
        return
    
    # Рассылка
    if data == "send":
        groups = get_groups(uid)
        if not groups:
            await event.edit("❌ Нет групп", buttons=[[Button.inline("◀️ Назад", b"back")]])
            return
        pending[uid] = {'groups': [{'id': g['id'], 'title': g['title']} for g in groups]}
        await event.respond(
            f"📨 ВСЕ ГРУППЫ: {len(groups)}\n\nОтправьте текст (можно с фото)",
            buttons=[[Button.inline("◀️ Назад", b"back")]]
        )
        states[uid] = "broadcast"
        await event.answer()
        return
    
    # Подписка
    if data == "sub":
        st, days = get_sub(uid)
        text = f"🛍️ ПОДПИСКА\n\n📦 {st} | {days} дн.\n\n"
        text += "💰 Цены:\n🎁 3 дн. - БЕСПЛАТНО\n📦 30 дн. - 450 руб\n⭐ 90 дн. - 599 руб\n💎 365 дн. - 1499 руб\n👑 НАВСЕГДА - 1999 руб\n\n"
        text += f"💳 {CARD}\n{CARD_HOLDER}"
        await event.edit(text, buttons=[
            [Button.inline("🎁 Пробная", b"trial")],
            [Button.inline("📦 30 дн.", b"buy30")],
            [Button.inline("⭐ 90 дн.", b"buy90")],
            [Button.inline("💎 365 дн.", b"buy365")],
            [Button.inline("👑 НАВСЕГДА", b"buy9999")],
            [Button.inline("◀️ Назад", b"back")]
        ])
        return
    
    if data == "trial":
        if trial(uid):
            await event.edit("✅ Пробная на 3 дня!")
        else:
            await event.edit("❌ Уже использована")
        await asyncio.sleep(1)
        st, days = get_sub(uid)
        await event.respond(f"👋 Меню\n📦 {st} | {days} дн.", buttons=menu(uid))
        return
    
    if data.startswith("buy"):
        days = int(data.replace("buy", ""))
        price = {30: 450, 90: 599, 365: 1499, 9999: 1999}[days]
        pid = save_payment(uid, days, price)
        await event.edit(
            f"💳 ОПЛАТА #{pid}\n\n📅 {days} дн. | 💰 {price} руб\n\n💳 {CARD}\n{CARD_HOLDER}\n💬 Коммент: {pid}\n\n📝 Отправьте скриншот",
            buttons=[[Button.inline("✅ Оплатил", b"paid")]]
        )
        return
    
    if data == "paid":
        await event.respond("📷 Отправьте скриншот")
        states[uid] = "payment"
        await event.answer()
        return
    
    # Инфо
    if data == "info":
        st, days = get_sub(uid)
        await event.edit(
            f"ℹ️ @{BOT_NAME}\n📌 v{VERSION}\n📦 {st} | {days} дн.\n📱 @sikvvg",
            buttons=[[Button.inline("◀️ Назад", b"back")]]
        )
        return
    
    # Админ
    if data == "admin":
        if uid not in ADMINS:
            await event.answer("⛔ Нет доступа", alert=True)
            return
        st = get_stats()
        await event.edit(
            f"👑 АДМИН\n\n👥 {fmt(st['users'])}\n🟢 {fmt(st['active'])}\n💰 {fmt(st['revenue'])} руб\n👥 {fmt(st['groups'])}\n💳 {fmt(st['pending'])}",
            buttons=[
                [Button.inline("📊 Статистика", b"stats")],
                [Button.inline("👥 Пользователи", b"users")],
                [Button.inline("💳 Платежи", b"payments")],
                [Button.inline("📢 Объявление", b"broadcast")],
                [Button.inline("◀️ Назад", b"back")]
            ]
        )
        return
    
    if data == "stats":
        if uid not in ADMINS:
            await event.answer("⛔ Нет доступа", alert=True)
            return
        st = get_stats()
        await event.edit(
            f"📊 СТАТИСТИКА\n\n👥 {fmt(st['users'])}\n🟢 {fmt(st['active'])}\n💰 {fmt(st['revenue'])} руб\n👥 {fmt(st['groups'])}\n💳 {fmt(st['pending'])}",
            buttons=[[Button.inline("◀️ Назад", b"admin")]]
        )
        return
    
    if data == "users":
        if uid not in ADMINS:
            await event.answer("⛔ Нет доступа", alert=True)
            return
        users = get_users()
        text = f"👥 ПОЛЬЗОВАТЕЛИ ({len(users)})\n\n"
        for u in users[:20]:
            s = "🟢" if u['has_sub'] else "🔴"
            if u['banned']:
                s = "⛔"
            text += f"{s} {u['id']} | @{u['username'] or 'нет'} | {u['sub_type']}\n"
        if len(users) > 20:
            text += f"\n... и еще {len(users)-20}"
        await event.edit(text, buttons=[[Button.inline("◀️ Назад", b"admin")]])
        return
    
    if data == "payments":
        if uid not in ADMINS:
            await event.answer("⛔ Нет доступа", alert=True)
            return
        payments = get_pending()
        if not payments:
            await event.edit("💳 Нет платежей", buttons=[[Button.inline("◀️ Назад", b"admin")]])
            return
        text = f"💳 ПЛАТЕЖИ ({len(payments)})\n\n"
        for p in payments[:10]:
            text += f"#{p['id']} | {p['user_id']} | {p['days']} дн. | {p['amount']} руб\n"
        await event.edit(text, buttons=[
            [Button.inline("✅ Подтвердить", b"confirm")],
            [Button.inline("◀️ Назад", b"admin")]
        ])
        return
    
    if data == "broadcast":
        if uid not in ADMINS:
            await event.answer("⛔ Нет доступа", alert=True)
            return
        await event.respond("📢 Введите сообщение для всех")
        states[uid] = "admin_broadcast"
        await event.answer()
        return
    
    if data == "confirm":
        if uid not in ADMINS:
            await event.answer("⛔ Нет доступа", alert=True)
            return
        await event.respond("🔢 Введите ID платежа")
        states[uid] = "confirm_pay"
        await event.answer()
        return
    
    # Назад
    if data == "back":
        states.pop(uid, None)
        pending.pop(uid, None)
        selected.pop(uid, None)
        st, days = get_sub(uid)
        await event.edit(f"👋 Меню\n📦 {st} | {days} дн.", buttons=menu(uid))
        await event.answer()
        return

# ============================================================================
# СООБЩЕНИЯ
# ============================================================================
@bot.on(events.NewMessage)
async def handle_msg(event):
    uid = event.sender_id
    state = states.get(uid)
    
    # Добавление аккаунта
    if state == "phone":
        phone = event.text.strip()
        if len(phone) < 10:
            await event.respond("❌ Неверный номер")
            return
        try:
            client = TelegramClient(StringSession(), API_ID, API_HASH)
            await client.connect()
            await client.send_code_request(phone)
            clients[uid] = client
            states[uid] = "code"
            await event.respond(f"📱 Код отправлен на {phone}\nВведите код:")
        except Exception as e:
            await event.respond(f"❌ {str(e)[:50]}")
            states.pop(uid, None)
        return
    
    if state == "code":
        client = clients.get(uid)
        if not client:
            await event.respond("❌ Ошибка")
            states.pop(uid, None)
            return
        try:
            await client.sign_in(code=event.text.strip())
            session = client.session.save()
            save_session(uid, session)
            await event.respond("✅ Аккаунт добавлен!")
            await client.disconnect()
            clients.pop(uid, None)
            states.pop(uid, None)
            st, days = get_sub(uid)
            await event.respond(f"👋 Меню\n📦 {st} | {days} дн.", buttons=menu(uid))
        except SessionPasswordNeededError:
            states[uid] = "password"
            await event.respond("🔐 Введите пароль 2FA:")
        except PhoneCodeInvalidError:
            await event.respond("❌ Неверный код, попробуйте еще:")
        except Exception as e:
            await event.respond(f"❌ {str(e)[:50]}")
            states.pop(uid, None)
        return
    
    if state == "password":
        client = clients.get(uid)
        if not client:
            await event.respond("❌ Ошибка")
            states.pop(uid, None)
            return
        try:
            await client.sign_in(password=event.text.strip())
            session = client.session.save()
            save_session(uid, session)
            await event.respond("✅ Аккаунт добавлен!")
            await client.disconnect()
            clients.pop(uid, None)
            states.pop(uid, None)
            st, days = get_sub(uid)
            await event.respond(f"👋 Меню\n📦 {st} | {days} дн.", buttons=menu(uid))
        except Exception as e:
            await event.respond(f"❌ {str(e)[:50]}")
            states.pop(uid, None)
        return
    
    # Рассылка
    if state == "broadcast":
        data = pending.get(uid)
        if not data:
            await event.respond("❌ Ошибка")
            states.pop(uid, None)
            return
        text = event.text or ""
        image = None
        if event.media and event.photo:
            try:
                image = await event.download_media(bytes)
            except:
                pass
        if not text and not image:
            await event.respond("📝 Отправьте текст")
            return
        data['text'] = text
        data['image'] = image
        await event.respond(
            f"📨 ПОДТВЕРЖДЕНИЕ\n\nГрупп: {len(data['groups'])}\n{trunc(text, 100)}\n\n✅ Начинаем?",
            buttons=[
                [Button.inline("✅ Да", b"yes")],
                [Button.inline("❌ Нет", b"no")]
            ]
        )
        states[uid] = "confirm"
        return
    
    # Платеж
    if state == "payment":
        if event.media and event.photo:
            await event.respond("✅ Скриншот получен!")
            for admin in ADMINS:
                try:
                    await bot.send_message(admin, f"💳 Платеж от {uid}")
                    await bot.forward_messages(admin, event.message)
                except:
                    pass
            states.pop(uid, None)
        else:
            await event.respond("📷 Отправьте скриншот")
        return
    
    # Админ рассылка
    if state == "admin_broadcast":
        if uid not in ADMINS:
            await event.respond("⛔ Нет доступа")
            states.pop(uid, None)
            return
        users = get_users()
        text = event.text or ""
        image = None
        if event.media and event.photo:
            try:
                image = await event.download_media(bytes)
            except:
                pass
        await event.respond(f"⏳ Отправка {len(users)} пользователям...")
        sent = 0
        for u in users:
            try:
                if image:
                    await bot.send_file(u['id'], image, caption=text)
                else:
                    await bot.send_message(u['id'], text)
                sent += 1
                await asyncio.sleep(0.3)
            except:
                pass
        await event.respond(f"✅ Готово! Отправлено: {sent}")
        states.pop(uid, None)
        return
    
    # Подтверждение платежа
    if state == "confirm_pay":
        if uid not in ADMINS:
            await event.respond("⛔ Нет доступа")
            states.pop(uid, None)
            return
        try:
            pid = int(event.text.strip())
            if confirm_pay(pid):
                await event.respond(f"✅ Платеж #{pid} подтвержден!")
            else:
                await event.respond(f"❌ Платеж #{pid} не найден")
        except:
            await event.respond("❌ Введите ID")
        states.pop(uid, None)
        return

# ============================================================================
# ДОПОЛНИТЕЛЬНЫЕ КНОПКИ
# ============================================================================
@bot.on(events.CallbackQuery)
async def extra(event):
    uid = event.sender_id
    data = event.data.decode()
    
    if data == "yes":
        data = pending.get(uid)
        if not data:
            await event.edit("❌ Ошибка")
            return
        await event.edit("⏳ Отправка...")
        ok, fail, failed = await send_groups(uid, data['groups'], data['text'], data.get('image'))
        text = f"✅ ГОТОВО!\n\n📨 {ok} отправлено\n❌ {fail} ошибок"
        if failed:
            text += f"\n⚠️ {', '.join(failed[:3])}"
        await event.edit(text)
        pending.pop(uid, None)
        states.pop(uid, None)
        selected.pop(uid, None)
        return
    
    if data == "no":
        pending.pop(uid, None)
        states.pop(uid, None)
        selected.pop(uid, None)
        await event.edit("❌ Отменено")
        st, days = get_sub(uid)
        await event.respond(f"👋 Меню\n📦 {st} | {days} дн.", buttons=menu(uid))
        return

# ============================================================================
# ЗАПУСК
# ============================================================================
async def main():
    logger.remove()
    logger.add(sys.stdout, level="INFO")
    
    db_init()
    
    await bot.start(bot_token=BOT_TOKEN)
    logger.info(f"🚀 @{BOT_NAME} v{VERSION}")
    
    for admin in ADMINS:
        try:
            await bot.send_message(admin, f"🚀 @{BOT_NAME} запущен!")
        except:
            pass
    
    await bot.run_until_disconnected()

if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        logger.info("🛑 Остановлен")
    except Exception as e:
        logger.error(f"❌ {e}")
        traceback.print_exc()
