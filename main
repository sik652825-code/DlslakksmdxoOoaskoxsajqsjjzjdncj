@dataclass
class UserData:
    user_id: int
    username: str = ""
    first_name: str = ""
    last_name: str = ""
    registered_at: str = ""
    subscription_end: str = ""
    subscription_type: str = "Нет"
    has_subscription: bool = False
    total_paid: int = 0
    trial_used: bool = False
    is_banned: bool = False
    checked_channels: bool = False
    referral_code: str = ""
    referred_by: int = 0
    referral_count: int = 0
    language: str = "ru"
    last_activity: str = ""
    notification_enabled: bool = True
    auto_send_enabled: bool = False
    
    def to_dict(self) -> Dict:
        return asdict(self)
    
    @classmethod
    def from_dict(cls, data: Dict) -> 'UserData':
        return cls(**data)

@dataclass
class GroupData:
    id: int
    user_id: int
    group_id: int
    group_username: str = ""
    group_title: str = ""
    group_type: str = "group"
    added_at: str = ""
    is_active: bool = True
    last_sent_at: str = ""
    send_count: int = 0

@dataclass
class PaymentData:
    id: int
    user_id: int
    amount: int
    days: int
    status: str = "pending"
    transaction_id: str = ""
    created_at: str = ""
    confirmed_at: str = ""
    confirmed_by: int = 0
    comment: str = ""

