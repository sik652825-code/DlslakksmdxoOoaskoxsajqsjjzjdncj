    sponsors = get_sponsors()
    if link not in sponsors:
        sponsors.append(link)
        return safe_json_save(SPONSORS_FILE, sponsors)
    return False

def remove_sponsor(link: str) -> bool:
    sponsors = get_sponsors()
    if link in sponsors:
        sponsors.remove(link)
        return safe_json_save(SPONSORS_FILE, sponsors)
    return False

def get_stats() -> Dict:
    with get_db_connection() as conn:
        c = conn.cursor()
        c.execute("SELECT COUNT(*) FROM users")
        total_users = c.fetchone()[0]
        c.execute("SELECT COUNT(*) FROM users WHERE has_subscription = 1 AND is_banned = 0")
        active_users = c.fetchone()[0]
        c.execute("SELECT SUM(total_paid) FROM users")
        revenue = c.fetchone()[0] or 0
        c.execute("SELECT COUNT(*) FROM sessions WHERE is_active = 1")
        accounts = c.fetchone()[0]
        c.execute("SELECT COUNT(*) FROM groups WHERE is_active = 1")
        groups = c.fetchone()[0]
        c.execute("SELECT COUNT(*) FROM payments WHERE status = 'pending'")
        pending = c.fetchone()[0]
        c.execute("SELECT COUNT(*) FROM users WHERE is_banned = 1")
        banned = c.fetchone()[0]
        return {
            "total_users": total_users,
            "active_users": active_users,
            "revenue": revenue,
            "accounts": accounts,
            "groups": groups,
            "pending": pending,
            "banned": banned
        }

# ============================================================================
# ОТПРАВКА СООБЩЕНИЙ (С ЗАЩИТОЙ ОТ ОБРЫВА СВЯЗИ)
# ============================================================================
async def check_user_channels(user_id: int) -> Tuple[bool, List[str]]:
    required_channels = get_required_channels()
    if not required_channels:
        return True, []
    session = get_session(user_id)
    if not session:
        return False, ["Нет аккаунта"]
    try:
        client = TelegramClient(StringSession(session), API_ID, API_HASH)
        await client.connect()
        me = await client.get_me()
        not_subscribed = []
        for channel_username in required_channels:
            try:
                clean_username = channel_username.replace('@', '')
                entity = await client.get_entity(clean_username)
                try:
                    await client.get_participant(entity, me.id)
                except (UserNotParticipantError, UserBannedInChannelError):
                    not_subscribed.append(channel_username)
            except Exception:
                not_subscribed.append(channel_username)
        await client.disconnect()
        return len(not_subscribed) == 0, not_subscribed
    except Exception as e:
        logger.error(f"❌ Ошибка проверки подписки: {e}")
        return False, ["Ошибка проверки подписки"]

async def send_message_to_groups(user_id: int, groups: List[Dict], text: str, image_data: Optional[bytes] = None, 
                                  is_scheduled: bool = False, is_forward: bool = False, 
                                  original_msg: Optional[Message] = None, delay_seconds: int = 60,
                                  is_auto_loop: bool = False) -> Dict:
    """
    Отправляет сообщения. Добавлены ретраи (повторы) при ошибках сети.
    """
    if not check_subscription(user_id):
        return {"success": 0, "fails": 0, "failed_groups": ["Подписка истекла"]}
    
    channels_ok, not_subscribed = await check_user_channels(user_id)
    if not channels_ok:
        return {"success": 0, "fails": 0, "failed_groups": [f"Подпишитесь на каналы: {', '.join(not_subscribed)}"]}
    
    session = get_session(user_id)
    if not session:
        return {"success": 0, "fails": 0, "failed_groups": ["Нет аккаунта"]}
    
    final_text = add_signature(text) if not is_forward else text
    success = 0
    fails = 0
    failed_groups = []
    
    try:
        # РЕТРАИ: попытки подключиться при обрыве соединения
        client = None
        for attempt in range(3):
            try:
                client = TelegramClient(StringSession(session), API_ID, API_HASH, connection_retries=5)
                await client.connect()
                break
            except (ConnectionError, OSError, TimeoutError) as net_err:
                logger.warning(f"⚠️ Ошибка сети (попытка подключения {attempt+1}/3): {net_err}")
                if attempt == 2:
                    raise Exception("Не удалось подключиться к Telegram после 3 попыток")
                await asyncio.sleep(5)
        
        total_groups = len(groups)
        for idx, group in enumerate(groups[:MAX_SEND_GROUPS]):
            try:
                group_id = int(group['id'])
                group_title = group.get('title') or group.get('username') or str(group_id)
                progress = f"({idx + 1}/{total_groups})"
                
                # РЕТРАИ: попытки отправки в конкретную группу
                for send_attempt in range(3):
                    try:
                        try:
                            entity = await client.get_entity(group_id)
                        except:
                            dialogs = await client.get_dialogs()
                            entity = None
                            for dialog in dialogs:
                                if dialog.entity.id == group_id:
                                    entity = dialog.entity
                                    break
                        
                        if not entity:
                            raise Exception("Entity не найдено")
                        
                        if is_forward and original_msg:
                            await client.forward_messages(entity, original_msg)
                        elif image_data:
                            await client.send_file(entity, image_data, caption=final_text)
                        else:
                            await client.send_message(entity, final_text)
                        
                        success += 1
                        if not is_scheduled and not is_auto_loop:
                            add_to_history(user_id, group_title, group_id, text, "sent")
                        logger.info(f"✅ {progress} Отправлено в {group_title}")
                        break # Успешно, выходим из ретраев
                        
                    except (ConnectionError, OSError, TimeoutError) as net_err:
                        logger.warning(f"⚠️ Ошибка сети при отправке в {group_title} (попытка {send_attempt+1}/3): {net_err}")
                        if send_attempt == 2:
                            raise Exception("Ошибка сети после 3 попыток отправки")
                        await asyncio.sleep(5)
                
                # Задержка между группами
                if idx < len(groups) - 1:
                    logger.info(f"⏳ Ожидание {delay_seconds} сек перед следующей группой...")
                    await asyncio.sleep(delay_seconds)
                
            except FloodWaitError as e:
                wait_time = e.seconds + FLOOD_WAIT_BUFFER
                logger.warning(f"⏳ Flood wait {wait_time} сек для {group_title}")
                await asyncio.sleep(wait_time)
                fails += 1
                failed_groups.append(group_title)
                if not is_auto_loop:
                    add_to_history(user_id, group_title, group_id, text, "error", f"FloodWait: {e.seconds} сек")
                
            except Exception as e:
                fails += 1
                failed_groups.append(group_title)
                error_msg = str(e)[:200]
                logger.error(f"❌ Ошибка в {group_title}: {error_msg}")
                if not is_auto_loop:
                    add_to_history(user_id, group_title, group_id, text, "error", error_msg)
                await asyncio.sleep(0.5)
        
        await client.disconnect()
        
    except Exception as e:
        logger.error(f"❌ Критическая ошибка: {e}")
        return {"success": 0, "fails": 1, "failed_groups": [str(e)[:100]]}
    
    return {"success": success, "fails": fails, "failed_groups": failed_groups}

# ============================================================================
# ФУНКЦИЯ: ДОБАВЛЕНИЕ ГРУПП ПО ССЫЛКЕ
# ============================================================================
async def add_groups_by_link(user_id: int, link: str) -> Dict:
    session = get_session(user_id)
    if not session:
        return {"success": 0, "failed": "Нет аккаунта"}
    try:
        client = TelegramClient(StringSession(session), API_ID, API_HASH, connection_retries=3)
        await client.connect()
        if not await client.is_user_authorized():
            await client.disconnect()
            return {"success": 0, "failed": "Аккаунт не авторизован"}
        
        added_groups = []
        
        if "addlist" in link:
            try:
                code = link.split("addlist/")[1].split("/")[0].split("?")[0]
                result = await client(ImportChatInviteRequest(code))
                if result and hasattr(result, 'chats'):
                    for chat in result.chats:
                        if hasattr(chat, 'id'):
                            add_group(user_id, chat.id, "", chat.title or "Группа", "group")
                            added_groups.append(chat.title or f"Группа {chat.id}")
            except Exception as e:
                return {"success": 0, "failed": f"Ошибка: {str(e)[:100]}"}
        
        elif "joinchat" in link or "+" in link and "t.me" in link:
            try:
                code = link.split("joinchat/")[1].split("/")[0].split("?")[0] if "joinchat" in link else link.split("+")[1].split("/")[0]
                result = await client(ImportChatInviteRequest(code))
                if result and hasattr(result, 'chats'):
                    for chat in result.chats:
                        if hasattr(chat, 'id'):
                            add_group(user_id, chat.id, "", chat.title or "Группа", "group")
                            added_groups.append(chat.title or f"Группа {chat.id}")
            except Exception as e:
                return {"success": 0, "failed": f"Ошибка: {str(e)[:100]}"}
        else:
            try:
                username = link.split("t.me/")[1].split("/")[0].split("?")[0]
                entity = await client.get_entity(username)
                if entity and hasattr(entity, 'participants_count'):
                    add_group(user_id, entity.id, username, entity.title or username, "group")
                    added_groups.append(entity.title or username)
            except Exception as e:
                return {"success": 0, "failed": f"Не удалось найти группу: {str(e)[:100]}"}
        
        await client.disconnect()
        if added_groups:
            return {"success": len(added_groups), "groups": added_groups}
        else:
            return {"success": 0, "failed": "Не удалось добавить группы"}
    except Exception as e:
        return {"success": 0, "failed": str(e)[:100]}

# ============================================================================
# ФУНКЦИЯ: ПЕРЕСЫЛКА (БЕЗ ПОДПИСИ)
# ============================================================================
async def forward_message_to_groups(user_id: int, groups: List[Dict], message_id: int, chat_id: int, delay_seconds: int = 60) -> Dict:
    if not check_subscription(user_id):
        return {"success": 0, "fails": 0, "failed_groups": ["Подписка истекла"]}
    
    channels_ok, not_subscribed = await check_user_channels(user_id)
    if not channels_ok:
        return {"success": 0, "fails": 0, "failed_groups": [f"Подпишитесь на каналы: {', '.join(not_subscribed)}"]}
    
    session = get_session(user_id)
    if not session:
        return {"success": 0, "fails": 0, "failed_groups": ["Нет аккаунта"]}
    
    success = 0
    fails = 0
    failed_groups = []
    
    try:
        # РЕТРАИ: подключение
        client = None
        for attempt in range(3):
            try:
                client = TelegramClient(StringSession(session), API_ID, API_HASH, connection_retries=3)
                await client.connect()
                break
            except (ConnectionError, OSError, TimeoutError) as net_err:
                logger.warning(f"⚠️ Ошибка сети (попытка {attempt+1}/3): {net_err}")
                if attempt == 2: raise Exception("Не удалось подключиться после 3 попыток")
                await asyncio.sleep(5)
        
        try:
            source_entity = await client.get_entity(chat_id)
            original_msg = await client.get_messages(source_entity, ids=message_id)
            if not original_msg:
                return {"success": 0, "fails": 1, "failed_groups": ["Сообщение не найдено"]}
        except Exception as e:
            return {"success": 0, "fails": 1, "failed_groups": [f"Ошибка получения сообщения: {str(e)[:100]}"]}
        
        total_groups = len(groups)
        for idx, group in enumerate(groups[:MAX_SEND_GROUPS]):
            try:
                group_id = int(group['id'])
                group_title = group.get('title') or group.get('username') or str(group_id)
                progress = f"({idx + 1}/{total_groups})"
                
                # РЕТРАИ: пересылка
                for send_attempt in range(3):
                    try:
                        try:
                            entity = await client.get_entity(group_id)
                        except:
                            dialogs = await client.get_dialogs()
                            entity = None
                            for dialog in dialogs:
                                if dialog.entity.id == group_id:
                                    entity = dialog.entity
                                    break
                        
                        if not entity:
                            raise Exception("Entity не найдено")
                        
                        await client.forward_messages(entity, original_msg)
                        success += 1
                        add_to_history(user_id, group_title, group_id, "Пересланное сообщение", "sent")
                        logger.info(f"✅ {progress} Переслано в {group_title}")
                        break
                        
                    except (ConnectionError, OSError, TimeoutError) as net_err:
                        logger.warning(f"⚠️ Ошибка сети при пересылке в {group_title} (попытка {send_attempt+1}/3): {net_err}")
                        if send_attempt == 2: raise Exception("Ошибка сети после 3 попыток")
                        await asyncio.sleep(5)
                
                if idx < len(groups) - 1:
                    logger.info(f"⏳ Ожидание {delay_seconds} сек перед следующей группой...")
                    await asyncio.sleep(delay_seconds)
                
            except FloodWaitError as e:
                wait_time = e.seconds + FLOOD_WAIT_BUFFER
                await asyncio.sleep(wait_time)
                fails += 1
                failed_groups.append(group_title)
                add_to_history(user_id, group_title, group_id, "Пересланное сообщение", "error", f"FloodWait: {e.seconds} сек")
            except Exception as e:
                fails += 1
                failed_groups.append(group_title)
                error_msg = str(e)[:200]
                logger.error(f"❌ Ошибка пересылки в {group_title}: {error_msg}")
                add_to_history(user_id, group_title, group_id, "Пересланное сообщение", "error", error_msg)
                await asyncio.sleep(0.5)
        
        await client.disconnect()
    except Exception as e:
        return {"success": 0, "fails": 1, "failed_groups": [str(e)[:100]]}
    
    return {"success": success, "fails": fails, "failed_groups": failed_groups}

# ============================================================================
# ФУНКЦИЯ: ОТПРАВКА ПО ССЫЛКЕ
# ============================================================================
async def send_by_link_func(user_id: int, link: str, text: str, image_data: Optional[bytes] = None) -> Dict:
    if not check_subscription(user_id):
        return {"success": 0, "failed": ["Подписка истекла"]}
    session = get_session(user_id)
    if not session:
        return {"success": 0, "failed": ["Нет аккаунта"]}
    try:
        client = TelegramClient(StringSession(session), API_ID, API_HASH, connection_retries=3)
        await client.connect()
        if not await client.is_user_authorized():
            await client.disconnect()
            return {"success": 0, "failed": ["Аккаунт не авторизован"]}
        entity = None
        if "t.me/" in link:
            parts = link.split("t.me/")[1].split("/")
            username = parts[0]
            if username.startswith("joinchat") or username.startswith("+") or username.startswith("join"):
                try:
                    entity = await client.get_entity(link)
                except:
                    return {"success": 0, "failed": ["Не удалось подключиться"]}
            else:
                try:
                    entity = await client.get_entity(username)
                except:
                    return {"success": 0, "failed": [f"Не найден чат @{username}"]}
        if not entity:
            return {"success": 0, "failed": ["Не удалось найти чат"]}
        final_text = add_signature(text)
        if image_data:
            await client.send_file(entity, image_data, caption=final_text)
        else:
            await client.send_message(entity, final_text)
        await client.disconnect()
        return {"success": 1, "failed": []}
    except Exception as e:
        return {"success": 0, "failed": [str(e)[:100]]}

# ============================================================================
# БЕСКОНЕЧНАЯ ЦИКЛИЧЕСКАЯ РАССЫЛКА (АВТОРАССЫЛКА)
# ============================================================================
async def auto_loop_task(user_id: int, groups: List[Dict], message: str, interval_seconds: int):
    """Фоновая задача, которая крутит рассылку по кругу."""
    logger.info(f"🔄 ЗАПУЩЕНА АВТОРАССЫЛКА для пользователя {user_id} (Интервал: {interval_seconds} сек)")
    
    while not running_loops.get(user_id, {}).get('stop_flag', True):
        start_time = time.time()
        try:
            logger.info(f"▶️ НАЧАЛО ЦИКЛА АВТОРАССЫЛКИ для {user_id}")
            
            # Отправляем с задержкой между группами 2 сек (чтобы не спамить подряд)
            result = await send_message_to_groups(user_id, groups, message, delay_seconds=2, is_auto_loop=True)
            
            elapsed = time.time() - start_time
            logger.info(f"⏹️ КОНЕЦ ЦИКЛА для {user_id}. Успешно: {result['success']}, Ошибок: {result['fails']}. Время выполнения: {elapsed:.1f} сек")
            
            wait_time = max(1, interval_seconds - elapsed)
            for _ in range(int(wait_time / 5)):
                if running_loops.get(user_id, {}).get('stop_flag', True):
                    break
                await asyncio.sleep(5)
            
        except Exception as e:
            logger.error(f"❌ КРИТИЧЕСКАЯ ОШИБКА В ЦИКЛЕ АВТОРАССЫЛКИ ({user_id}): {e}")
            await asyncio.sleep(60)

    logger.info(f"⏹️ АВТОРАССЫЛКА ОСТАНОВЛЕНА для пользователя {user_id}")
    if user_id in running_loops:
        del running_loops[user_id]

def stop_auto_loop(user_id: int) -> bool:
    if user_id in running_loops:
        running_loops[user_id]['stop_flag'] = True
        return True
    return False

